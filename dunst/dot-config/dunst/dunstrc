# User configuration for Dunst
#
# Copyright (c) 2026 Jerry Xeo

[global]
    monitor = 0
    follow = keyboard
    width = 200
    height = (0, 600)
    origin = top-right
    offset = (6,2)
    scale = 0
    notification_limit = 30
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 6
    horizontal_padding = 6
    frame_width = 2
    gap_size = 2
    separator_color = frame
    sort = true # make notifications grow downwards from the top
    font = "Adwaita Sans 9"
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = center
    vertical_alignment = top
    show_age_threshold = -1
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    history_length = 30
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/local/bin/brave-browser
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    corners = all
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = context_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#13161e"
    foreground = "#dddddd"
    frame_color= "#8ec07c"
    timeout = 7

[urgency_normal]
    background = "#13161e"
    foreground = "#eeeeee"
    frame_color = "#78a6e6"
    timeout = 12
    override_pause_level = 15

[urgency_critical]
    background = "#2f1a21"
    foreground = "#ffffff"
    frame_color = "#dc6868"
    timeout = 0
    override_pause_level = 60

