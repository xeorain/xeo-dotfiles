[submodule "zsh/plugins/powerlevel10k"]
	path = zsh/dot-config/zsh/plugins/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k.git
	depth = 1
	shallow = true
[submodule "zsh/plugins/zsh-completions"]
	path = zsh/dot-config/zsh/plugins/zsh-completions
	url = https://github.com/zsh-users/zsh-completions.git
	depth = 1
	shallow = true
[submodule "zsh/plugins/zsh-history-substring-search"]
	path = zsh/dot-config/zsh/plugins/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search.git
	depth = 1
	shallow = true
[submodule "zsh/plugins/zsh-syntax-highlighting"]
	path = zsh/dot-config/zsh/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
	depth = 1
	shallow = true
