set $mode_resize '<span fallback="true">󰩨</span>  \
[<b>h</b>] width -10 \
[<b>l</b>] width +10 \
[<b>k</b>] height -10 \
[<b>j</b>] height +10 \
[<b>J</b>] width -30 \
[<b>L</b>] width +30 \
[<b>K</b>] height -30 \
[<b>J</b>] height +30 \
[<b>-</b>] gap -2 \
[<b>+</b>] gap +2'

mode --pango_markup $mode_resize {
    $bindsym $left resize shrink width 10px
    $bindsym $up resize grow height 10px
    $bindsym $down resize shrink height 10px
    $bindsym $right resize grow width 10px

    $bindsym $left_alt resize shrink width 10px
    $bindsym $up_alt resize grow height 10px
    $bindsym $down_alt resize shrink height 10px
    $bindsym $right_alt resize grow width 10px

    $bindsym Shift+$left resize shrink width 30px
    $bindsym Shift+$up resize grow height 30px
    $bindsym Shift+$down resize shrink height 30px
    $bindsym Shift+$right resize grow width 30px

    $bindsym Shift+$left_alt resize shrink width 30px
    $bindsym Shift+$up_alt resize grow height 30px
    $bindsym Shift+$down_alt resize shrink height 30px
    $bindsym Shift+$right_alt resize grow width 30px

    ## Resize // Window gaps // + - ##
    $bindsym minus gaps inner current minus 2px
    $bindsym plus gaps inner current plus 2px

    ## Return to default mode
    $bindsym Return mode "default"
    $bindsym Escape mode "default"
    $bindsym $mod+Ctrl+r mode "default"
}

## Launch // Resize Mode ##
$bindsym $mod+Ctrl+r mode $mode_resize

# vim:ft=swayconfig
