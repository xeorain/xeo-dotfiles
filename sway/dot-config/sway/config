### Variables
#
# Logo key. Use Mod1 for Alt and Mod4 for Super.
set $mod Mod4
set $alt_mod Mod1

# Vim-like direction keys.
set $left h
set $down j
set $up k
set $right l

# Alternative direction keys.
set $left_alt Left
set $down_alt Down
set $up_alt Up
set $right_alt Right

# Add --to-code to bindsym for supporting non-latin layouts.
set $bindsym bindsym --to-code

# Preferred terminal emulator.
set $term footclient
set $term_float $term --app-id _floating_term --window-size-chars 82x25

# Preferred application launcher.
set $menu rofi -terminal '$term' -show combi -combi-modes 'drun#run' -modes combi -theme-str 'prompt{enabled:false;}'

### Input configuration
#
# Run `swaymsg -t get_inputs` to list all inputs.
# See `man 5 sway-input` for more information.
#
# Hide cursor after 5 seconds of inactivity.
#seat seat0 hide_cursor 5000
# Hide cursor when typing starts.
seat seat0 hide_cursor when-typing enable

# Disallow applications to inhibit Sway shortcuts, i.e., grab total control of
# the keyboard. Chrome currently abuses this by enabling it for all "--app=..."
# shortcuts.
seat * shortcuts_inhibitor disable

# Keyboard
input "type:keyboard" {
    xkb_layout "us"
    repeat_delay 300
    repeat_rate 30
}

# Touchpad
input "type:touchpad" {
    # Disable touchpad while typing
    dwt enabled
    # Enable tap-to-click support
    tap enabled
    events enabled
    natural_scroll enabled
}

### Output configuration
#
# Custom wallpaper which is a fixed symlink.
# Requires:   swaybg
output * bg ~/.local/share/wallpaper fill

# Enable adaptive sync, make sure your display supports FreeSync or G-Sync.
output DP-1 adaptive_sync on

### Navigation configuration
focus_follows_mouse no
force_display_urgency_hint 500 ms
mouse_warping none

### Environment variables
#
# NOTE:
# * WAYLAND_DISPLAY is explicitly imported here in case services started by
#   `systemctl --user start` in config.d/96-autostart.conf fail to start due to
#   a missing WAYLAND_DISPLAY. Although /etc/sway/config.d/10-systemd-session.conf
#   (from the sway-systemd package) executes the /usr/libexec/sway-systemd/session.sh
#   script which invokes `systemctl --user import-environment` at a certain
#   point to import some environment variables including WAYLAND_DISPLAY, there
#   will be a race condition as Sway executes commands in parallel, and
#   WAYLAND_DISPLAY may not yet be set when a program depending on it as a
#   precondition is about to start.
# * XDG_SESSION_ID is imported because some programs spawn by `systemd --user`
#   look for it to name a PID file or lock file.
# * XEO_SH_EXTRA_NEV_FILE is required for `systemd --user` to clean up my
#   personal extra environment file at logout.
exec dbus-update-activation-environment --systemd PATH DISPLAY WAYLAND_DISPLAY XDG_SESSION_ID XEO_SH_EXTRA_ENV_FILE

### Key bindings, binding modes and theme
include bindings
include modes
include theme

### Additional configurations
include /etc/sway/config.d/*.conf
include ~/.config/sway/config.d/*.conf

