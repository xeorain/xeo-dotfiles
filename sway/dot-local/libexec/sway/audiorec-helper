#
# A helper script that launches `xeo-audiorec` (a wrapper for `pw-record`)
# in Sway.
#
# Usage: audiorec-helper [OPTION]...
#
# Options:
#   -b BARNAME  set the name of status bar to BAR
#   -s SIGNUM   set the signal number to SIG
#
# Requires:   sway, xeo-audiorec

bar_signal_cmd="${HOME}/.local/libexec/xeo-utils-desktop/bar-signal"

command -v xeo-audiorec >/dev/null 2>&1 \
  && [ -x "${bar_signal_cmd}" ] \
  || exit 1

# Ensure singleton
main_pid=$$
pidfile="${XDG_RUNTIME_DIR:-/tmp}/sway-$(basename -- "$0")-${EUID:-$(id -u)}-${XDG_SESSION_ID:-$(cat /proc/self/sessionid)}.pid"
if [ -f "${pidfile}" ]; then
  pid="$(cat "${pidfile}")"
  [ -n "${pid:-}" ] && kill -0 "${pid}" >/dev/null 2>&1 && exit
  unset pid
fi
printf '%s' "${main_pid}" > "${pidfile}"

on_exit() {
  trap - EXIT
  [ -n "${need_signal_bar:-}" ] && "${bar_signal_cmd}" "${bar}" "${sig}"
  rm -f "${pidfile}"
}

trap 'on_exit' EXIT

while [ $# -gt 0 ]; do
  case "$1" in
    -b)
      bar="${2:-}"
      shift
      ;;
    -s)
      sig="${2:-}"
      shift
      ;;
    *)
      break
      ;;
  esac
  shift
done
[ -n "${bar:-}" ] && [ -n "${sig:-}" ] && need_signal_bar=1;

set --

printf 'Set output file (press Enter for auto generation): \n'
read -r outfile
[ -n "${outfile:-}" ] && set -- "$@" "${outfile}"

if [ -n "${need_signal_bar:-}" ]; then
  # The recorder wrapper script (xeo-audiorec) may interact with the user,
  # which could take some time. We spawn a subshell in the background to wait
  # until the actual recorder process (`pw-record` in this case) is running. The
  # user may cancel this helper script before the recorder starts, so we need to
  # kill the subshell if the parent is cancelled.
  (
    while ! pgrep -xU "${USER}" pw-record >/dev/null; do
      # Exit the subshell when the parent is dead.
      kill -0 ${main_pid} 2>/dev/null || exit 0
      sleep 0.2
    done
    "${bar_signal_cmd}" "${bar}" "${sig}"
  ) &
fi

xeo-audiorec "$@"
