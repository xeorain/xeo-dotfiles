#!/bin/bash
# SPDX-License-Identifier: MIT
#
# Copyright (c) 2026 Jerry Xeo
#
# A helper script that inhibits system idle for a specified time period.
#
# Usage: xeo-inhibit-idle [interactive|off]
#
# Requires:   libnotify, rofi (>= 2.0) or rofi-wayland, systemd

set -uo pipefail
shopt -u expand_aliases

# Check status
if [ $# -eq 0 ]; then
  st_out="$(pgrep -u "${EUID}" -af 'systemd-inhibit --what=idle')"
  [ -n "${st_out:-}" ] || exit 1
  st_secs="$(awk '{print $NF}' <<<"${st_out}")"
  [ -n "${st_secs:-1}" ] || exit 1
  st_mins=$((st_secs / 60))
  printf '%s' "${st_mins}"
  exit 0
fi

if ! command -v rofi >/dev/}" = 'tty' ]
}

notify() {
  ! is_on_tty \
    && check_cmd notify-send \
    && notify-send -r 99 -t 1101 -a "${XEO_INHIDLE_PROG}" "${XEO_INHIDLE_PROG}" "$1"
}

start_inhibit() {
  systemd-inhibit \
    --what=idle \
    --who=swayidle-inhibit \
    --why=commanded \
    --mode=block sleep "${secs}" &
}

stop_inhibit() {
  pkill -u "${EUID}" -f "systemd-inhibit --what=idle"
}

case "$1" in
  interactive)
    mins="$(printf '0\n1\n10\n15\n20\n30\n45\n60\n90\n120\nunlimited' \
      | rofi -dmenu \
             -p "[${XEO_INHIDLE_PROG}] how many minutes to inhibit idle:" \
             --theme-str 'listview{lines:11;}')"
    case "${mins:-}" in
      '')
        exit 1
        ;;
      '0')
        stop=1
        ;;
      'unlimited')
        secs=$((365 * 24 * 60 * 60))
        ;;
      *)
        secs=$((mins * 60))
        ;;
    esac
    ;;
  off)
    stop=1
    ;;
esac

stop_inhibit
status=$?
if [ -n "${stop:-}" ]; then
  [ "${status}" = 0 ] && notify "Idle inhibition stopped"
  exit "${status}"
fi

start_inhibit
status=$?
[ "${status}" = 0 ] && notify "Inhibit idle for ${mins} minutes"
exit "${status}"
