# Initialize Zsh completion system.

if [[ -v _z4x_compinit_fd ]]; then
  zle -F $_z4x_compinit_fd
  exec {_z4x_compinit_fd}>&-
  unset _z4x_compinit_fd
fi

# Undefine the custom `compdef` function defined in -z4x-init-zle to make the
# built-in `compdef` visible.
unfunction compdef

# Do not complete .zwc files for editor commands.
local -aU editors=(
  vi vim nvim emacs nano gedit code kak kate mcedit joe "$EDIT" "$VISUAL"
  bat cat less more "$PAGER")
zstyle ':completion:*:*:('${(j:|:)editors}'):*:*' ignored-patterns '*.zwc'

zstyle ':completion:*' list-colors '${(@s.:.)LS_COLORS}'

# Add extra completion definitions from the zsh-completions plugin.
(( _z4x_use[zsh-completions] )) \
  && [[ -d "$ZDOTDIR/plugins/zsh-completions" ]] \
  && fpath+=("$ZDOTDIR/plugins/zsh-completions/src")

# Create completion cache directory.
if zstyle -t ':completion::complete:' use-cache; then
  local cache
  zstyle -s ':completion::complete:' cache-path cache
  : ${cache:=${ZDOTDIR:-~}/.zcompcache}
  if [[ ! -e "${cache}" ]]; then
    zf_mkdir -m 0700 -p -- "${cache}"
  fi
fi

# --- Update completion dump file ------------------------------------------{{{
# Set the path to the completion dump file.
local dump
zstyle -s ':z4x:compinit' dump-path dump
: ${dump:=${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/zcompdump-$EUID-$ZSH_VERSION}

# Find all completion definition files (staring with _) from each directory
# specified in fpath, but ignoring those ending with ~ (editor backup files) or
# .zwc (compiled files).
local -a files=(${^fpath}/^([^_]*|*~|*.zwc)(-.N))
local -a stats
# Get the modification time of all found completion definition files.
(( ! ${#files} )) || zstat -A stats +mtime -- $files
# Construct an array that reflects the current signature (status), including Zsh
# version, Zsh patch level, all completion files, and their modification time.
local real_sig=($ZSH_VERSION $ZSH_PATCHLEVEL $files $stats)

# If the real signature we found exactly match the signature part in the dump
# file, meaning nothing has changed, we just let the completion system load the
# dump file. Otherwise, update (or create if not yet existed) the dump file with
# the real signature, and then compile it.
#
# INFO: The completion dump file caches a map between command names and their
# corresponding completion files, allowing Zsh to quickly locate the completion
# function for a command being typed without searching the filesystem. When
# executing `compinit -d <dumpfile>`, Zsh directly loads the dump file if it
# exists; otherwise, Zsh will initialize its completion system from scratch by
# locating all completion definition files in all directories specified in
# fpath, and then writes the mappings to the dump file.
local sig
if [[ -r "$dump" ]] \
    && sysread -s ${#real_sig} sig <"$dump" \
    && [[ "$sig" == "$real_sig" && -r "$dump".zwc ]] \
    && zstat -A stats +mtime -- "$dump" "$dump".zwc \
    && (( stats[2] == stats[1] + 1 )); then
  # The -C flag explicitly skips internal security checks inside compinit,
  # trusting the signature check we just finished.
  -z4x-compinit-impl -C -d "$dump"
else
  # The block of code below:
  # * Removes old dump file and temporary files.
  # * Initializes the completion system from scratch, and dump to a temporary
  #   file $tmp.
  # * Creates a second temporary file $tmp.2 from $tmp with real signature
  #   added.
  # * Moves $tmp.2 to the permanent dump file path, and compiles the dump file.
  local tmp="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump.${sysparams[pid]}"
  zf_rm -f -- "$dump" "$dump".zwc "$tmp" "$tmp".2
  -z4x-compinit-impl -C -d "$tmp"
  { print -rn -- $real_sig; <"$tmp" } >"$tmp".2
  zf_rm -f -- "$tmp"
  zf_mv -- "$tmp".2 "$dump"
  -z4x-compile "$dump"
fi
# }}}

# Replay real compdef calls.
local args
for args in "${_z4x_compdef[@]}"; do
  compdef "${(@0)args}"
done
unset _z4x_compdef

