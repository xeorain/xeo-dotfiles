# Set terminal title.

emulate -L zsh -o no_prompt_bang -o prompt_subst -o prompt_percent

local title="$1"
shift
print -Prnv title -- "$title"
printf -v title '\e]0;%s\a' "${(V)title}"

if [[ -t 1 ]]; then
  print -rn -- "$title"
elif [[ -v _z4x_tty_fd ]]; then
  print -rnu $_z4x_tty_fd -- "$title"
fi

# vim:ft=zsh
