# Prepare the zsh-syntax-highlighting plugin.

local pkg_dir="$ZDOTDIR/plugins/zsh-syntax-highlighting"

[[ -d "$pkg_dir" ]] || return

[[ "$1" == (-f|--force) ||
    ! "$pkg_dir/zsh-syntax-highlighting.zsh.zwc" -nt "$pkg_dir/zsh-syntax-highlighting.zsh" ]] \
  || return

eval "$_z4x_opt"

z4x compile -- "$pkg_dir"/{zsh-syntax-highlighting.zsh,highlighters/*/*.zsh}(N)

