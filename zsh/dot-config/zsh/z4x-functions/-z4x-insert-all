local hook="${widgets[zle-line-pre-redraw]-}"
if [[ "$hook" == 'user:'* ]]; then
  hook="${hook#user:}"
else
  hook=
fi

{
  if [[ -n "$hook" ]]; then
    builtin zle -D zle-line-pre-redraw
  fi
  builtin zle -- -z4x-comp-insert-all
} always {
  if [[ -n "$hook" ]]; then
    zle -N -- zle-line-pre-redraw "$hook"
  fi
}

# vim:ft=zsh
