# A ZLE widget based on fzf for TAB completion.

[[ -v _z4x_tty_fd ]] || return

# Initialize the completion system if not yet done.
[[ ! -v _z4x_compinit_fd ]] || -z4x-compinit || true

[[ -o auto_menu ]] && local -i auto_menu=1 || local -i auto_menu=0

setopt local_options always_to_end no_auto_list no_auto_menu \
       no_auto_param_keys no_auto_remove_slash no_bash_auto_list \
       no_complete_in_word no_list_ambiguous no_list_beep no_list_packed \
       no_list_rows_first no_menu_complete no_rec_exact

local -ra _z4x_shadow_funcs=(_main_complete _multi_parts _path_files _setup compadd zstyle)

local f
for f in "$_z4x_shadow_funcs[@]"; do
  if (( ${+functions[$f]} )); then
    builtin functions -c -- $f -z4x-orig-$f
    local _z4x_orig_${f#_}=-z4x-orig-$f
  else
    eval "local -a _z4x_orig_${f#_}=(builtin $f)"
  fi
done

# exec 3>&2 2>/tmp/log

{
  # setopt xtrace

  function zstyle() {
    # zstyle -T ":completion:${curcontext}:$_type" list-grouped
    if [[ $# == 3 && "$3" == 'list-grouped' && "$1" == -(t|T) && "$2" == :completion:* ]]; then
      return 1
    else
      $_z4x_orig_zstyle "$@"
    fi
  }

  function _setup () {}

  function _multi_parts() {
    local _z4x_sep="${@[-2]}"
    local _z4x_array="${@[-1]}"
    shift -p 2
    [[ $# != 0 && "${@[-1]}" == (-|--) ]] && shift -p
    () {
      emulate -L zsh
      if [[ "$_z4x_array" == '('* ]]; then
        _z4x_array=(${=_z4x_array[2,-2]})
      else
        _z4x_array=("${(@P)_z4x_array}")
      fi
    }
    # This ** is not ideal but alternatives are worse.
    #
    # Consider the following setup:
    #
    #   git init
    #   mkdir -p foo1 foo2/bar
    #   touch foo1/qux foo2/bar/qux
    #   git add .
    #   git commit --allow-empty-message -m ''
    #   rm foo1/qux foo2/bar/qux
    #   git commit <TAB>
    #
    # At this point there are two trial completions: foo1/qux and foo2/bar/qux.
    #
    # With ** we'll get foo/qux with the cursor after foo. Another TAB will
    # give summon fzf to choose between the two trial completions.
    #
    # With a single * we'll get the same completion on the first TAB (foo/qux
    # with the cursor after foo). Another TAB will produce foo1/qux. That's
    # quite awful. The awfulness is expecially obvious if auto_menu is set.
    # In this case `git commit <TAB>` will complete foo1/qux in a single go,
    # even though there are two files to commit.
    #
    # The ideal behavior would be foo on the first TAB and fzf with both
    # trial completions on the second. We can achieve this by dropping -M.
    # However, this would not allow us to complete f/b, and we want that.
    compadd -M "r:|${_z4x_sep}=** r:|=*" "$@" - "${_z4x_array[@]}"
  }

  function _path_files() {
    () {
      # TODO: respect pats and ignore somehow.
      local -a opts files dirs pats ignore
      zparseopts -a mopts f=files /=dirs g+:=pats F:=ignore \
        P: S: q r: R: W:  M+: J+: V+: x+: X+: 1 2 o+: n
      local -i patdirs=${#pats}
      while (( ${#pats} )); do
        if [[ "${pats[2]}" != ('*(-/)'|'*(#q-/)') ]]; then
          patdirs=0
          break
        fi
        builtin shift 2 pats
      done
      (( patdirs )) && dirs=(-/)
      (( ${#files} || ! ${#dirs} )) && typeset -gi _z4x_only_dirs=0
    } "$@"
    local -ir _z4x_in_path_files=1
    $_z4x_orig_path_files "$@"
  }

  function compadd() {
    local -a _z4x_{opts,nDOA,q,f,s,S,I,W,i,P,p,d,r,R,e,U}
    zparseopts -E -a _z4x_opts {D,O,A}+:=_z4x_nDOA n+=_z4x_nDOA \
      f+=_z4x_f s+:=_z4x_s S+:=_z4x_S I+:=_z4x_I W+:=_z4x_W     \
      i+:=_z4x_i P+:=_z4x_P p+:=_z4x_p d+:=_z4x_d q+=_z4x_q     \
      r+:=_z4x_r R+:=_z4x_R e+=_z4x_e U+=_z4x_U                 \
      {a,k,l,1,2,C,Q}+ {F,J,X,x,V,E,M}+: o+::
    if (( ${#_z4x_nDOA} )); then
      $_z4x_orig_compadd "$@"
      return
    fi
    local -a _z4x_A _z4x_D
    if (( ${#_z4x_d} )); then
      () {
        emulate -L zsh
        local _z4x_arr="$_z4x_d[2]"
        if [[ "$_z4x_arr" == '('* ]]; then
          _z4x_D=(${=_z4x_arr[2,-2]})
        else
          _z4x_D=("${(@P)_z4x_arr}")
        fi
      }
    fi
    $_z4x_orig_compadd -A _z4x_A -D _z4x_D "$@" || true
    (( ${#_z4x_A} )) || return
    # Many completers read $compstate[nmatches], which can be super slow if there are
    # many matches that require deduplication. We drop everything in an unsorted
    # group without deduplication to avoid this cost. We deduplicate everything manually
    # at a later stage.
    $_z4x_orig_compadd -V- -2 -o nosort -J- "$@" || return

    emulate -L zsh
    typeset -g _z4x_curcontext="$curcontext"
    if (( ${#_z4x_D} < ${#_z4x_A} )); then
      _z4x_D+=(${_z4x_A:${#_z4x_D}})
    elif (( ${#_z4x_D} > ${#_z4x_A} )); then
      _z4x_D[${#_z4x_A}+1,-1]=()
    fi
    _z4x_words+=("${_z4x_A[@]}")
    _z4x_descrs+=("${_z4x_D[@]}")
    if (( ! ${#_z4x_U} )); then
      _z4x_i=(-i "$IPREFIX$_z4x_i[2]")
      _z4x_I=(-I "$_z4x_I[2]$ISUFFIX")
    fi
    local scaffold=(
      "$_z4x_in_path_files"
      "$_z4x_P[2]" "$_z4x_S[2]" "$_z4x_p[2]" "$_z4x_s[2]" "$_z4x_i[2]" "$_z4x_I[2]"
      "$_z4x_q[1]" "$_z4x_r[2]" "$_z4x_R[2]" "$_z4x_f[1]" "$_z4x_e[1]" "$_z4x_W[2]"
      "$PREFIX" "$SUFFIX")
    scaffold=${(pj:\1:)scaffold}
    if (( ! ${#_z4x_scaffolds} )); then
      _z4x_scaffolds=("$scaffold")
      if [[ "$IPREFIX$PREFIX" == "$_z4x_i[2]$_z4x_P[2]$_z4x_p[2]"* ]]; then
        _z4x_word_prefix="${${:-$IPREFIX$PREFIX}#$_z4x_i[2]$_z4x_P[2]$_z4x_p[2]}"
      fi
    elif (( ${#_z4x_scaffolds} > 1 )) || [[ "$_z4x_scaffolds[1]" != "$scaffold" ]]; then
      repeat $(( ${#_z4x_words} - ${#_z4x_scaffolds} - ${#_z4x_A} )); do
        _z4x_scaffolds+=("$_z4x_scaffolds[1]")
      done
      repeat ${#_z4x_A} _z4x_scaffolds+=($scaffold)
    fi
  }

  -z4x-cursor-hide

  local ZLE_REMOVE_SUFFIX_CHARS ZLE_SPACE_SUFFIX_CHARS
  unset ZLE_REMOVE_SUFFIX_CHARS ZLE_SPACE_SUFFIX_CHARS

  local -i again=1
  while (( again )); do
    {
      -z4x-show-dots "$LBUFFER"

      local buf="$BUFFER"
      local -i cursor=CURSOR

      local -a _z4x_words=()
      local -a _z4x_descrs=()
      local -a _z4x_scaffolds=()
      local -i _z4x_only_dirs=1
      local -i _z4x_in_path_files=0
      local -i _z4x_in_quotes=0
      local _z4x_curcontext=
      local _z4x_word_prefix=

      functions -c -- -z4x-main-complete _main_complete
      builtin zle expand-or-complete
      if [[ "$buf" == "$BUFFER" && "$cursor" == "$CURSOR" ]]; then
        (( ${#_z4x_words} )) || return 0
        local _z4x_path_prefix=
        if () {
            emulate -L zsh
                (( ${#_z4x_scaffolds} == 1 && !_z4x_in_quotes )) || return
                local -a s=("${(@ps:\1:)_z4x_scaffolds}")
                [[ "$s[1]" == 1 && -z "$s[3]" && -z "$s[5]" && -z "$s[7]" &&
                  -n "$s[11]" && "$s[13]" == (|*/) && -z "$s[15]" ]] || return
                typeset -g _z4x_path_prefix="$s[13]"
            }; then
          local -a _z4x_reply=()
          if builtin zstyle -t ":completion:${_z4x_curcontext}:default" sort; then
            _z4x_words=("${(@ou)_z4x_words}")
          else
            _z4x_words=("${(@u)_z4x_words}")
          fi
          -z4x-sanitize-word-prefix "${_z4x_words[@]}"
          -z4x-comp-files || return
          () {
            emulate -L zsh
            again="${_z4x_reply[1]}"
            _z4x_words=("${(@q)_z4x_reply:1}")
          }
          -z4x-insert-all || return
        else
          local -a _z4x_reply=()
          local nl=$'\n'
          _z4x_descrs=("${(@)_z4x_descrs//$nl/\\n}")
          -z4x-sanitize-word-prefix "${_z4x_descrs[@]}"
          -z4x-comp-words || return
          () {
            emulate -L zsh
            again="${_z4x_reply[1]}"
            local -i idx=0
            local words=()
            if (( ${#_z4x_scaffolds} == 1 )); then
              for idx in "${(@)_z4x_reply:1}"; do
                words+=("${_z4x_words[idx]}")
              done
            else
            local scaffolds=()
              for idx in "${(@)_z4x_reply:1}"; do
                words+=("${_z4x_words[idx]}")
                scaffolds+=("${_z4x_scaffolds[idx]}")
              done
              _z4x_scaffolds=("${scaffolds[@]}")
            fi
            _z4x_words=("${words[@]}")
          }
          -z4x-insert-all || return
        fi
      else
        if (( auto_menu )); then
          _z4x_words=("${(@ou)_z4x_words}")
          again=$(( ${#_z4x_words} > 1 ))
        else
          again=0
        fi
      fi

      if [[ "$LBUFFER" == *' ' && "$RBUFFER" == ' '* ]]; then
        RBUFFER[1]=
      else
        BUFFER="$BUFFER"
      fi

      [[ "$BUFFER" == "$buf" && "$CURSOR" == "$cursor" ]] && return
      builtin zle .split-undo || return
      [[ "$LBUFFER" == *' ' ]] && return
    } always {
      if (( _z4x_use[zsh-autosuggestions] || _z4x_use[zsh-syntax-highlighting] )); then
        -z4x-redraw-buffer
      fi
    }
  done
} always {
  # unsetopt xtrace
  # exec 2>&3 3>&-
  local f=
  for f in "${_z4x_shadow_funcs[@]}"; do
    if (( ${+functions[-z4x-orig-$f]} )); then
      builtin functions -c -- -z4x-orig-$f $f
      builtin unfunction -- -z4x-orig-$f
    elif (( ${+functions[$f]} )); then
      builtin unfunction -- $f
    fi
  done
  builtin zle -R
  -z4x-cursor-show
}

# vim:ft=zsh
