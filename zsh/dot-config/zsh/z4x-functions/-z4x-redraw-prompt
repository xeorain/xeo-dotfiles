{
  -z4x-cursor-hide
  local f
  for f in chpwd "${chpwd_functions[@]}" precmd "${(@)precmd_functions:#-z4x-direnv-hook}"; do
    (( ! ${+functions[$f]} )) || "$f" &>/dev/null || true
  done
  if (( _z4x_use[zsh-syntax-highlighting] )); then
    typeset -g _ZSH_HIGHLIGHT_PRIOR_BUFFER=
    typeset -gi _ZSH_HIGHLIGHT_PRIOR_CURSOR=0
  fi
  zle .reset-prompt
  (( ${1:-0} )) || zle -R
} always {
  (( ${1:-0} )) || -z4x-cursor-show
  -z4x-update-dir-history
}

# vim:ft=zsh
