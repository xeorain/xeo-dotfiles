# In Zsh:
#
#   $*    equivalent to $@ (acts as an array, drops empty elements,
#         preserves spaces)
#   "$*"  same as $* in Bash (concatenating all positional arguments into a
#         $IFS-separated string)
#   $@    drops empty elements and allows globbing (unquoted array behavior)
#   "$@"  preserves empty elements and suppresses globbing (strict array
#         behavior)
() {
  emulate -L zsh -o extended_glob
  [[ "$_z4x_word_prefix" != *('$'|'\') ]] || return
  if [[ "$_z4x_word_prefix" == *[A-Z]* ]]; then
    [[ -z "${(@)*:#$_z4x_word_prefix*}" ]] || return
  else
    [[ -z "${(@)*:#(#i)$_z4x_word_prefix*}" ]] || return
  fi
} "$@" || _z4x_word_prefix=
_z4x_word_prefix="${_z4x_word_prefix// /\\ }"

