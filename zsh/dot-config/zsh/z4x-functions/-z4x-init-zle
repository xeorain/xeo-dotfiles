# z4x initialization for ZLE (Zsh Line Editor).
#
# * Load ZLE widgets
# * Build key code compatibility layer
# * Configure and load core plugins
# * Configure completion system
# * Set key bindings

# iTerm2 shell integration
if { zstyle -t :z4x: term-shell-integration || zstyle -t :z4x: iterm2-integration } \
    && [[ "$TERM" != (dumb|linux) && "ITERM_SHELL_INTEGRATION_INSTALLED" != 'Yes' &&
          -z "$NVIM_LISTEN_ADDRESS" && -z "$NVIM" ]]; then
  -z4x-enable-iterm2-integration
else
  function -z4x-iterm2-precmd() {}
  function -z4x-iterm2-preexec() {}
fi

# Displa the running command in the terminal title
function -z4x-set-term-title-preexec() {
  emulate -L zsh
  local _z4x_fmt
  if [[ -n "$SSH_CONNECTION" || $P9K_SSH == 1 ]]; then
    zstyle -s :z4x:term-title:ssh preexec _z4x_fmt || _z4x_fmt='%n@%m: ${1//\%/%%}'
  else
    zstyle -s :z4x:term-title:local preexec _z4x_fmt || _z4x_fmt='${1//\%//%%}'
  fi
  -z4x-iterm2-preexec
  [[ -z "$_z4x_fmt" ]] || -z4x-set-term-title $_z4x_fmt "$@"
}

# Display the current directory in the terminal title when no command is running
function -z4x-set-term-title-precmd() {
  local -i err=$?
  emulate -L zsh
  local _z4x_fmt
  if [[ -n "$SSH_CONNECTION" || $P9K_SSH == 1 ]]; then
    zstyle -s :z4x:term-title:ssh precmd _z4x_fmt || _z4x_fmt='%n@%m: %~'
  else
    zstyle -s :z4x:term-title:ssh precmd _z4x_fmt || _z4x_fmt='%~'
  fi
  -z4x-iterm2-precmd $err
  [[ -z "$_z4x_fmt" ]] || -z4x-set-term-title "$_z4x_fmt"
}

autoload -Uz up-line-or-beginning-search \
             down-line-or-beginning-search \
             edit-command-line || return
autoload -Uz run-help ${^fpath}/run-help-^*.zwc(N:t) || return
add-zsh-hook -- preexec -z4x-set-term-title-preexec || return
add-zsh-hook -- precmd -z4x-set-term-title-precmd || return
[[ -v aliases[run-help] ]] && unalias run-help

# A global associative array that tracks core plugins in use. A core plugin can
# be disabled in .zshrc via `zstyle t :z4x:<plugin> channel none`.
typeset -gA _z4x_use
local pkg
for pkg in fzf powerlevel10k zsh-completions zsh-history-substring-search \
            zsh-syntax-highlighting; do
  zstyle -t ":z4x:${pkg}" channel none || _z4x_use[${pkg}]=1
done
typeset -grA _z4x_use

if (( _z4x_use[powerlevel10k] && ! ${#POWERLEVEL9k_CONFIG_FILE} )); then
  POWERLEVEL9K_CONFIG_FILE="$ZDOTDIR/.p10k"
  if [[ $langinfo[CODESET] != (utf|UTF)(-|)8 || "${TERM}" == (dumb|linux) ]]; then
    POWERLEVEL9K_CONFIG_FILE+='-ascii'
  fi
  (( terminfo[colors] >= 256 )) || POWERLEVEL9K_CONFIG_FILE+='-8color'
  POWERLEVEL9K_CONFIG_FILE+='.zsh'
fi

function z4x-up-prefix-local() {
  -z4x-with-local-history 1 up-line-or-beginning-search "$@"
}
function z4x-down-prefix-local() {
  -z4x-with-local-history 1 down-line-or-beginning-search "$@"
}
function z4x-up-prefix-global() {
  -z4x-with-local-history 0 up-line-or-beginning-search "$@"
}
function z4x-down-prefix-global() {
  -z4x-with-local-history 0 down-line-or-beginning-search "$@"
}

if (( _z4x_use[zsh-history-substring-search] )); then
  function z4x-up-substring-local() {
    -z4x-with-local-history 1 history-substring-search-up "$@"
  }
  function z4x-down-substring-local() {
    -z4x-with-local-history 1 history-substring-search-down "$@"
  }
  function z4x-up-substring-global() {
    -z4x-with-local-history 0 history-substring-search-up "$@"
  }
  function z4x-down-substring-global() {
    -z4x-with-local-history 0 history-substring-search-down "$@"
  }
fi

function z4x-kill-word() { -z4x-move-and-kill z4x-forward-word }
function z4x-backward-kill-word() { -z4x-move-and-kill z4x-backward-word }
function z4x-kill-zword() { -z4x-move-and-kill z4x-forward-zword }
function z4x-backward-kill-zword() { -z4x-move-and-kill z4x-backward-zword }

function z4x-beginning-of-buffer() { CURSOR=0 }
function z4x-end-of-buffer() {
  typeset -gi CURSOR='_z4x_cursor_max()'
}
function z4x-expand() { zle _expand_alias || zle .expand-word || true }

function z4x-cd-back() { -z4x-cd-rotate +1 }
function z4x-cd-forward() { -z4x-cd-rotate -0 }
function z4x-cd-up() { builtin cd -q .. && -z4x-redraw-prompt }

# Functions that shows/hides cursor.
if (( ${+terminfo[civis]} && ${+terminfo[cnorm]} )) && [[ -v _z4x_tty_fd ]]; then
  function -z4x-cursor-hide() {
    [[ -t 1 ]] && echoti civis || echoti civis >&$_z4x_tty_fd
  }
  function -z4x-cursor-show() {
    # Drop all escape sequences in $terminfo[cnorm] (especially $'\e[?12l' which
    # blinks the cursor) except for $'\e[?25h'.
    # See https://github.com/romkatv/powerlevel10k/issues/1699.
    local cnorm=${${terminfo[cnorm]-}:/*$'\e[?25h'(|'\e'*)/$'\e[?25h'}
    [[ -t 1 ]] && print -rn -- "$cnorm" || print -rnu $_z4x_tty_fd -- "$cnorm"
  }
else
  function -z4x-cursor-hide() {}
  function -z4x-cursor-show() {}
fi

# Sets `_z4x_cursor_max` as a math function that takes zero arguments, thus
# allowing it to be called directly in the arithmetic syntax without command
# substitution, e.g., `(( _z4x_cursor_max() ))` instead of `(( $(_z4x_cursor_max) ))`.
functions -M -- _z4x_cursor_max 0 0

# --- Register ZLE widgets -------------------------------------------------{{{
zle -N edit-command-line
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zle -N z4x-accept-line
zle -N z4x-eof
zle -N z4x-exit
zle -N z4x-expand
zle -N z4x-forward-word
zle -N z4x-kill-word
zle -N z4x-backward-word
zle -N z4x-backward-kill-word
zle -N z4x-forward-zword
zle -N z4x-kill-zword
zle -N z4x-backward-zword
zle -N z4x-backward-kill-zword
zle -N z4x-beginning-of-buffer
zle -N z4x-end-of-buffer
zle -N z4x-stash-buffer
zle -N z4x-up-prefix-local
zle -N z4x-down-prefix-local
zle -N z4x-up-prefix-global
zle -N z4x-down-prefix-global
if (( _z4x_use[zsh-history-substring-search] )); then
  zle -N z4x-up-substring-local
  zle -N z4x-down-substring-local
  zle -N z4x-up-substring-global
  zle -N z4x-down-substring-global
fi
zle -N z4x-cd-back
zle -N z4x-cd-forward
zle -N z4x-cd-up
zle -N z4x-cd-down
zle -N z4x-fzf-complete
zle -N z4x-fzf-dir-history
zle -N z4x-fzf-history
zle -N z4x-fg-bg-job

# Create a new -z4x-comp-insert-all widget and hook it into the built-in
# complete-word engine. Whenever triggered, the complete-word engine will invoke
# the registered function to fetch and process the completion results.
zle -C -- -z4x-comp-insert-all complete-word -z4x-comp-insert-all

# --- Built-in parameters --------------------------------------------------{{{
PROMPT_EOL_MARK='%K{red} %k'  # mark the missing \n at the end of command output with a red block
WORDCHARS=''                  # allow only alphanums to make up words in word-based widgets
ZLE_REMOVE_SUFFIX_CHARS=''    # don't eat space when typing '|' after a tab completion
KEYTIMEOUT=20                 # wait for 200ms for the continuation of a key sequence

# Use an XDG-compliant state directory for history data.
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
# Commands to be excluded from the history.
HISTORY_IGNORE=('cd|cd -|cd ..|pwd|ls|ll|exit|reboot|shutdown')
HISTSIZE=10000  # maximum number of command history entries kept in memory
SAVEHIST=10000  # maximum number of entries allowed in history file

# Prepare the history directory.
[[ -d "${XDG_STATE_HOME:-$HOME/.local/state}/zsh" ]] \
  || zf_mkdir -m 0700 -p -- "${XDG_STATE_HOME:-$HOME/.local/state}/zsh" \
  || return
# }}}

# ZLE widgets specifically for Vi mode.
# Load modules and functions specifically for Vi mode.
autoload -Uz select-bracketed select-quoted surround
zle -N select-bracketed
zle -N select-quoted
zle -N add-surround surround
zle -N change-surround surround
zle -N delete-surround surround
zle -N incarg z4x-incarg
zle -N decarg z4x-incarg

# For cursor shape switch between vicmd and viins modes.
local _z4x_vi_mode
if zstyle -t :z4x: vi-mode; then
  _z4x_vi_mode=1
  typeset -g _z4x_vicmd_cursor_shape
  typeset -g _z4x_viins_cursor_shape
  case "$TERM" in
    ^(linux|dumb))
      _z4x_vicmd_cursor_shape='\033[2 q'
      _z4x_viins_cursor_shape='\033[6 q'
      ;;
    linux)
      _z4x_vicmd_cursor_shape='\033[?17;0;240c'
      _z4x_viins_cursor_shape='\033[?2c'
      ;;
  esac
  typeset -gr _z4x_vicmd_cursor_shape
  typeset -gr _z4x_viins_cursor_shape
  zle -N zle-keymap-select _z4x_zle_keymap_select

  # NOTE: The text editor (e.g., vim) run by the `edit-command-line` widget may
  # change the cursor shape, but Zsh won't invoke the `_zle_keymap_select`
  # widget after the editor exits, because the KEYMAP parameter (which indicates
  # the current ZLE keymap mode) doesn't change; we have to manually restore the
  # original cursor shape.
  function z4x-edit-command-line-vicmd() {
    zle edit-command-line
    print -nu $_z4x_tty_fd $_z4x_vicmd_cursor_shape
  }
  zle -N z4x-edit-command-line-vicmd

  function z4x-edit-command-line-viins() {
    zle edit-command-line
    print -nu $_z4x_tty_fd $_z4x_viins_cursor_shape
  }
  zle -N z4x-edit-command-line-viins
else
  _z4x_vi_mode=0
fi
# }}}

# --- Key code translation for compatibility -------------------------------{{{
# Discard all user-defined key bindings and restore the built-in defaults.
bindkey -d

local keymap
for keymap in emacs viins vicmd; do
  # If NumLock is off, translate keys to make them appear the same as with
  # NumLock on.
  bindkey -M "$keymap" -s '^[OM'     '^M'      # enter
  bindkey -M "$keymap" -s '^[OX'     '='
  bindkey -M "$keymap" -s '^[Oj'     '*'
  bindkey -M "$keymap" -s '^[Ok'     '+'
  bindkey -M "$keymap" -s '^[Ol'     '+'
  bindkey -M "$keymap" -s '^[Om'     '-'
  bindkey -M "$keymap" -s '^[On'     '.'
  bindkey -M "$keymap" -s '^[Oo'     '/'
  bindkey -M "$keymap" -s '^[Op'     '0'
  bindkey -M "$keymap" -s '^[Oq'     '1'
  bindkey -M "$keymap" -s '^[Or'     '2'
  bindkey -M "$keymap" -s '^[Os'     '3'
  bindkey -M "$keymap" -s '^[Ot'     '4'
  bindkey -M "$keymap" -s '^[Ou'     '5'
  bindkey -M "$keymap" -s '^[Ov'     '6'
  bindkey -M "$keymap" -s '^[Ow'     '7'
  bindkey -M "$keymap" -s '^[Ox'     '8'
  bindkey -M "$keymap" -s '^[Oy'     '9'

  # If someone switches our terminal to application mode (smkx), translate keys
  # to make them appear the same as in raw mode (rmkx).
  bindkey -M "$keymap" -s '^[OA'     '^[[A'    # up
  bindkey -M "$keymap" -s '^[OB'     '^[[B'    # down
  bindkey -M "$keymap" -s '^[OD'     '^[[D'    # left
  bindkey -M "$keymap" -s '^[OC'     '^[[C'    # right
  bindkey -M "$keymap" -s '^[OH'     '^[[H'    # home
  bindkey -M "$keymap" -s '^[OF'     '^[[F'    # end

  # TTY sends different key codes. Translate them to xterm equivalents.
  # Missing: {ctrl,alt,shift}+{up,down,left,right,home,end}, {ctrl,alt}+delete.
  bindkey -M "$keymap" -s '^[[1~'    '^[[H'    # home
  bindkey -M "$keymap" -s '^[[4~'    '^[[F'    # end

  # Urxvt sends different key codes. Translate them to xterm equivalents.
  bindkey -M "$keymap" -s '^[[7~'    '^[[H'    # home
  bindkey -M "$keymap" -s '^[[8~'    '^[[F'    # end
  bindkey -M "$keymap" -s '^[Oa'     '^[[1;5A' # ctrl+up
  bindkey -M "$keymap" -s '^[Ob'     '^[[1;5B' # ctrl+down
  bindkey -M "$keymap" -s '^[Od'     '^[[1;5D' # ctrl+left
  bindkey -M "$keymap" -s '^[Oc'     '^[[1;5C' # ctrl+right
  bindkey -M "$keymap" -s '^[[7\^'   '^[[1;5H' # ctrl+home
  bindkey -M "$keymap" -s '^[[8\^'   '^[[1;5F' # ctrl+end
  bindkey -M "$keymap" -s '^[[3\^'   '^[[3;5~' # ctrl+delete
  bindkey -M "$keymap" -s '^[^[[A'   '^[[1;3A' # alt+up
  bindkey -M "$keymap" -s '^[^[[B'   '^[[1;3B' # alt+down
  bindkey -M "$keymap" -s '^[^[[D'   '^[[1;3D' # alt+left
  bindkey -M "$keymap" -s '^[^[[C'   '^[[1;3C' # alt+right
  bindkey -M "$keymap" -s '^[^[[7~'  '^[[1;3H' # alt+home
  bindkey -M "$keymap" -s '^[^[[8~'  '^[[1;3F' # alt+end
  bindkey -M "$keymap" -s '^[^[[3~'  '^[[3;3~' # alt+delete
  bindkey -M "$keymap" -s '^[[a'     '^[[1;2A' # shift+up
  bindkey -M "$keymap" -s '^[[b'     '^[[1;2B' # shift+down
  bindkey -M "$keymap" -s '^[[d'     '^[[1;2D' # shift+left
  bindkey -M "$keymap" -s '^[[c'     '^[[1;2C' # shift+right
  bindkey -M "$keymap" -s '^[[7$'    '^[[1;2H' # shift+home
  bindkey -M "$keymap" -s '^[[8$'    '^[[1;2F' # shift+end

  # Tmux sends different key codes. Translate them to xterm equivalents.
  bindkey -M "$keymap" -s '^[[1~'    '^[[H'    # home
  bindkey -M "$keymap" -s '^[[4~'    '^[[F'    # end
  bindkey -M "$keymap" -s '^[^[[A'   '^[[1;3A' # alt+up
  bindkey -M "$keymap" -s '^[^[[B'   '^[[1;3B' # alt+down
  bindkey -M "$keymap" -s '^[^[[D'   '^[[1;3D' # alt+left
  bindkey -M "$keymap" -s '^[^[[C'   '^[[1;3C' # alt+right
  bindkey -M "$keymap" -s '^[^[[1~'  '^[[1;3H' # alt+home
  bindkey -M "$keymap" -s '^[^[[4~'  '^[[1;3F' # alt+end
  bindkey -M "$keymap" -s '^[^[[3~'  '^[[3;3~' # alt+delete

  # iTerm2 sends different key codes. Translate them to xterm equivalents.
  # Missing (depending on settings): ctrl+{up,down,left,right}, {ctrl,alt}+{delete,backspace}.
  bindkey -M "$keymap" -s '^[^[[A'   '^[[1;3A' # alt+up
  bindkey -M "$keymap" -s '^[^[[B'   '^[[1;3B' # alt+down
  bindkey -M "$keymap" -s '^[^[[D'   '^[[1;3D' # alt+left
  bindkey -M "$keymap" -s '^[^[[C'   '^[[1;3C' # alt+right
  bindkey -M "$keymap" -s '^[[1;9A'  '^[[1;3A' # alt+up
  bindkey -M "$keymap" -s '^[[1;9B'  '^[[1;3B' # alt+down
  bindkey -M "$keymap" -s '^[[1;9D'  '^[[1;3D' # alt+left
  bindkey -M "$keymap" -s '^[[1;9C'  '^[[1;3C' # alt+right
  bindkey -M "$keymap" -s '^[[1;9H'  '^[[1;3H' # alt+home
  bindkey -M "$keymap" -s '^[[1;9F'  '^[[1;3F' # alt+end

  # TODO: Add missing translations.
done
# }}}

# --- Core Key bindings ---------------------------------------------------{{{1
# Key bindings for both emacs and viins keymap modes ----------------------{{{2
for keymap in emacs viins; do
  # Move cursor one char backward
  bindkey -M "$keymap"   '^[[D'    backward-char                  # left
  # Move cursor one char forward
  bindkey -M "$keymap"   '^[[C'    forward-char                   # right

  if (( _z4x_use[zsh-history-substring-search] )); then
    # Move cursor one line up or fetch the previous command from LOCAL history.
    bindkey -M "$keymap" '^P'      z4x-up-substring-local         # ctrl+p
    bindkey -M "$keymap" '^[[A'    z4x-up-substring-local         # up
    # Move cursor one line up or fetch the next command from LOCAL history.
    bindkey -M "$keymap" '^N'      z4x-down-substring-local       # ctrl+n
    bindkey -M "$keymap" '^[[B'    z4x-down-substring-local       # down
  else
    # Move cursor one line up or fetch the previous command from LOCAL history.
    bindkey -M "$keymap" '^P'      z4x-up-prefix-local            # ctrl+p
    bindkey -M "$keymap" '^[[A'    z4x-up-prefix-local            # up
    # Move cursor one line up or fetch the next command from LOCAL history.
    bindkey -M "$keymap" '^N'      z4x-down-prefix-local          # ctrl+n
    bindkey -M "$keymap" '^[[B'    z4x-down-prefix-local          # down
  fi

  # Move cursor one line up or fetch the previous command from GLOBAL history.
  bindkey -M "$keymap"   '^[[1;5A' z4x-up-prefix-global           # ctrl+up
  bindkey -M "$keymap"   '^[[1;5B' z4x-down-prefix-global         # ctrl+down
  # Move cursor to the beginning of line.
  bindkey -M "$keymap"   '^[[H'    beginning-of-line              # home
  # Move cursor to the end of line.
  bindkey -M "$keymap"   '^[[F'    end-of-line                    # end
  # Move cursor to the beginning of buffer.
  bindkey -M "$keymap"   '^[[1;5H' z4x-beginning-of-buffer        # ctrl+home
  bindkey -M "$keymap"   '^[[1;3H' z4x-beginning-of-buffer        # alt+home
  # Move cursor to the end of buffer.
  bindkey -M "$keymap"   '^[[1;5F' z4x-end-of-buffer              # ctrl+end
  bindkey -M "$keymap"   '^[[1;3F' z4x-end-of-buffer              # alt+end

  # Delete line before cursor.
  bindkey -M "$keymap"   '^[k'     backward-kill-line             # alt+k
  bindkey -M "$keymap"   '^[K'     backward-kill-line             # alt+K
  # Delete all lines.
  bindkey -M "$keymap"   '^[j'     kill-buffer                    # alt+j
  bindkey -M "$keymap"   '^[J'     kill-buffer                    # alt+J

  # Push buffer to ephemeral history (won't be saved to HISTFILE) and delete all lines.
  bindkey -M "$keymap"   '^[o'     z4x-stash-buffer               # alt+o
  bindkey -M "$keymap"   '^[O'     z4x-stash-buffer               # alt+O

  # Show help for the command at cursor.
  bindkey -M "$keymap"   '^[h'     run-help                       # alt+h
  bindkey -M "$keymap"   '^[H'     run-help                       # alt+H
  # Undo and redo.
  bindkey -M "$keymap"   '^[[Z'    undo                           # shift+tab
  bindkey -M "$keymap"   '^[/'     redo                           # alt+/
  # Expand alias/glob/parameter.
  bindkey -M "$keymap"   '^ '      z4x-expand                     # ctrl+space
  # Generic command completion.
  bindkey -M "$keymap"   '^I'      z4x-fzf-complete               # tab
  if (( _z4x_use[fzf] )); then
    # Command history
    bindkey -M "$keymap" '^R'      z4x-fzf-history                # ctrl+r
  fi
  # Directory history.
  bindkey -M "$keymap"   '^[r'     z4x-fzf-dir-history            # alt+r
  bindkey -M "$keymap"   '^[R'     z4x-fzf-dir-history            # alt+R

  # cd into the previous directory.
  bindkey -M "$keymap"   '^[[1;2D' z4x-cd-back                    # shift+left
  # cd into the next directory.
  bindkey -M "$keymap"   '^[[1;2C' z4x-cd-forward                 # shift+right
  # cd into the parent directory.
  bindkey -M "$keymap"   '^[[1;2A' z4x-cd-up                      # shift+up
  if (( _z4x_use[fzf] )); then
    # cd into a subdirectory (interactive).
    bindkey -M "$keymap" '^[[1;2B' z4x-cd-down                    # shift+down
  fi

  # Switch a job between foreground and background
  bindkey -M "$keymap"   '^z'      z4x-fg-bg-job                  # ctrl+z

  # Edit buffer in the editor specified by $EDITOR
  bindkey -M "$keymap"   '^X^E'    edit-command-line              # ctrl+x ctrl+e
done
# }}}2

# --- emacs-mode-only key bindings ----------------------------------------{{{2
# Delete the character under the cursor.
bindkey -M emacs         '^D'      delete-char                    # ctrl+d
bindkey -M emacs         '^[[3~'   delete-char                    # delete
# Delete next word.
bindkey -M emacs         '^[d'     z4x-kill-word                  # alt+d
bindkey -M emacs         '^[D'     z4x-kill-word                  # alt+D
bindkey -M emacs         '^[[3;5~' z4x-kill-word                  # ctrl+del
bindkey -M emacs         '^[[3;3~' z4x-kill-word                  # alt+del
# Delete previous word.
bindkey -M emacs         '^W'      z4x-backward-kill-word         # ctrl+w
bindkey -M emacs         '^[^?'    z4x-backward-kill-word         # alt+bs
bindkey -M emacs         '^[^H'    z4x-backward-kill-word         # ctrl+alt+bs

# Move cursor one zsh word forward
bindkey -M emacs         '^[[1;6C' z4x-forward-zword              # ctrl+shift+right
# Move cursor one zsh word backward
bindkey -M emacs         '^[[1;6D' z4x-backward-zword             # ctrl+shift+left
# Delete next zsh word
bindkey -M emacs         '^[[3;6~' z4x-kill-zword                 # ctrl+shift+del

# Move cursor one word backward.
bindkey -M emacs         '^[b'     z4x-backward-word              # alt+b
