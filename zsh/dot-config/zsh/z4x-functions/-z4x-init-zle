# --- Post-initialization callback ----------------------------------------{{{1
# INFO:
#
#   precmd_functions   a built-in array recording all functions that are invoked
#                      right before a command-line prompt is drawn.
#   preexec_functions  a built-in array records the functions that are invoked
#                      after you press Enter, but right before the command
#                      actually executes.
#   chpwd_functions    a built-in array records all function that are invoked
#                      whenever the current working directory changes.
function -z4x-post-init() {
  eval "$_z4x_opt"

  # Remove `-z4x-post-init` from the `precmd_functions` array to ensure it is
  # called only once.
  precmd_functions=(${precmd_functions:#-z4x-post-init})

  typeset -gi _z4x_compinit_fd
  if [[ -v __p9k_fd_0 ]] && zselect -t0 -r $__p9k_fd_0 \
      && sysopen -o cloexec -ru _z4x_compinit_fd /dev/null; then
    # Register the `-z4x-cominit` function as a handler for the
    # `z4x_compinit_fd` file descriptor. Since /dev/null is always readable,
    # this handler will trigger as soon as Zsh enters the ZLE main event loop.
    zle -F $_z4x_compinit_fd -z4x-compinit
  else
    unset _z4x_compinit_fd
    -z4x-compinit
    -z4x-update-dir-history
  fi

  if (( _z4x_use[zsh-syntax-highlighting] )); then
    () {
      # Register user ZLE widgets to zsh-syntax-highlighting so that they can
      # be invoked by zsh-syntax-highlighting.
      autoload -Uz is-at-least
      if is-at-least 5.9; then
        # zsh-syntax-highlighting 0.8.0 and newer versions favor the Zsh
        # built-in `add-zle-hook-widget` function (if available) to register
        # user zle-line-finish and zle-line-pre-redraw widgets.
        #
        # NOTE: The `add-zle-hook-widget` function is only available in Zsh
        # v5.9+. Also, the name of the widget to be registered cannot start
        # with a hyphen, so we wrap fucntions that start with -z4x.
        function _z4x_zle-line-pre-redraw() { zle -z4x-zle-line-pre-redraw -- "$@" }
        function _z4x_zle-line-finish() { zle -z4x-zle-line-finish -- "$@" }
        local -hA widgets=(
          zle-line-pre-redraw _z4x_zle-line-pre-redraw
          zle-line-finish _z4x_zle-line-finish
        )
      else
        # For Zsh prior to 5.9, zsh-syntax-highlighting executes the old
        # implementation, which expects the `user:` prefix for user ZLE widget
        # registration. For example, it wraps the current zle-line-finish
        # widget as a original widget into its own `_zsh_highlight_widget_zle-line-finish`
        # function, and then registers that function as the zle-line-finish widget.
        #
        # NOTE: When zsh-syntax-highlighting doesn't step in with
        # `add-zle-hook-widget`, powerlevel10k can catch the user
        # zle-line-pre-redraw widget and wrap it in its own zle-line-pre-redraw
        # widget, so there is no need to put it in the widgets array.
        local -hA widgets=(
          zle-line-finish user:_zsh_highlight_widget_zle-line-finish
          zle-isearch-update user:_zsh_highlight_widget_zle-isearch-update
        )
      fi
      builtin source "$ZDOTDIR/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    }
    preexec_functions=(${preexec_functions:#_zsh_highlight_preexec_hook})
    # INFO:
    #
    #   PENDING            a Zsh built-in that contains the number of bytes that
    #                      have been typed by the user at the terminal but have
    #                      not yet been read by the shell. For example, if you
    #                      paste a massive chunk of text, PENDING will instantly
    #                      jump to a high number.
    #   KEYS_QUEUED_COUNT  a Zsh built-in that contains the number of bytes that
    #                      were already read by Zsh, but were intentionally
    #                      pushed back into the input queue (using tools like
    #                      `zle -U`). These are available to be read immediately
    #                      before Zsh performs any new terminal I/O.
    eval '_zsh_highlight() {
      [[ ${WIDGET-} == zle-line-pre-redraw && ${LASTWIDGET-} == accept-line ]] && return
      {
        if [[ ${#BUFFER} -gt ${ZSH_HIGHLIGHT_MAXLENGTH:-${#BUFFER}} ]]; then
          region_highlight=()
        else
          local -ih PENDING=0 KEYS_QUEUED_COUNT=0
          '$functions[_zsh_highlight]'
        fi
      } always {
        [[ $WIDGET == zle-line-finish ]] || region_highlight+=("${_z4x_substring_search_highlight[@]}")
      }
    }'
  fi

  if (( _z4x_use[zsh-history-substring-search] )); then
    function _history-substring-search-end() {
      builtin eval "$_z4x_opt"
      if (( _history_substring_search_refresh_display )); then
        typeset -gi CURSOR='_z4x_cursor_max()'
      fi
      typeset -g _history_substring_search_result="$BUFFER"
      typeset -gi _history_substring_search_cursor=CURSOR
      unset _z4x_substring_search_highlight
      [[ -z "$_history_substring_search_query_highlight" ]] && return
      local query_part escaped_query_part REPLY
      local -i highlight_start_index highlight_end_index query_part_match_index
      for query_part in $_history_substring_search_query_parts; do
        escaped_query_part=${query_part//(#m)[\][()|\\*?#<>~^]/\\$MATCH}
        query_part_match_index=${${BUFFER:$highlight_start_index}[(i)(#$HISTORY_SUBSTRING_SEARCH_GLOBBING_FLAGS)${escaped_query_part}]}
        (( query_part_match_index > ${#BUFFER} - highlight_start_index )) && continue
        highlight_start_index=$(( highlight_start_index + query_part_match_index ))
        highlight_end_index=$(( highlight_start_index + ${#query_part} ))
        _z4x_substring_search_highlight+=(
          "$((highlight_start_index - 1)) $((highlight_end_index - 1)) $_history_substring_search_query_highlight")
      done
    }

    # This function is buggy in the original implementation when vicmd is active.
    function _history-substring-search-up-buffer() {
      builtin eval "$_z4x_opt"

      # The original implementation is equivalent to this one with the exception
      # of the condition on the next line being (( CURSOR != $#BUFFER )).
      (( CURSOR != _z4x_cursor_max() )) || return

      [[ "$LBUFFER" == *$'\n'* ]] || return
      builtin zle up-line-or-history || true
    }

    # See _history-substring-search-up-buffer above.
    function _history-substring-search-down-buffer() {
      builtin eval "$_z4x_opt"
      (( CURSOR != _z4x_cursor_max() )) || return
      [[ "$RBUFFER" == *$'\n'* ]] || return
      builtin zle down-line-or-history || true
    }
  elif [[ -v functions[_history-substring-search-end] ]]; then
    # Turn off highlighting in _history-substring-search-end. It doesn't work anyway.
    function _history-substring-search-end() {
      emulate -L zsh
      _history_substring_search_result="$BUFFER"
      if (( _history_substring_search_refresh_display )); then
        typeset -gi CURSOR='_z4x_cursor_max()'
      fi
    }
  fi

  # --- Shell integration handling ----------------------------------------{{{2
  # iTerm2 integration guard.
  if (( ! ${+_z4x_iterm_cmd} )) && [[ "$ITERM_SHELL_INTEGRATION_INSTALLED" == 'Yes' ]]; then
    -z4x-error-iterm2-integration
  fi

  # Patch Zsh built-in bracketed-paste-magic function.
  # See the $ZDOTDIR/z4x-functions/bracket-paste-magic file.
  if [[ -v functions[bracketed-paste-magic] ]]; then
    builtin unfunction bracketed-paste-magic
    builtin autoload -Uz -- "$ZDOTDIR/z4x-functions/bracketed-paste-magic"
  fi

  # Override the __vte_osc7 function which is used to broadcast shell's current
  # working directory to the terminal emulator.
  if [[ -v _z4x_tty_fd ]]; then
    if [[ -v functions[__vte_osc7] ]]; then
      builtin functions -c -- -z4x-vte-osc7 __vte_osc7
    fi
    if { zstyle -t :z4x: term-shell-integration || zstyle t :z4x: iterm2-integratin } \
        && [[ "$TERM" != (dumb|linux) ]]; then
      builtin functions -c -- -z4x-vte-osc7 __vte_osc7
      if (( ! $precmd_functions[(I)_vte_osc7] )); then
        precmd_functions=(__vte_osc7 $precmd_functions)
        __vte_osc7
      fi
      # Local session in WSL (Windows Subsystem for Linux).
      if [[ -v z4x_win_env && -z "${SSH_CONNECTION-}" && ${P9K_SSH-} != 1 ]]; then
        chpwd_functions+=(-z4x-osc9)
        -z4x-osc9
      fi
    fi
  fi
  # }}}2

  # Send WINCH just in case we've set incorrect TTY dimensions manually
  builtin kill -WINCH $$
}

# Add `-z4x-post-init` to `precmd_functions` so that it can be invoked right
# before a command-line prompt is drawn.
precmd_functions=(-z4x-post-init ${precmd_functions})
# }}}1

typeset -g iterm2_hostname="${HOST:-${(%):-%m}}"

typeset -ga _z4x_dir_history

# -----------------------------------------------------------------------------
# A custom `compdef` function that shadows the built-in to collect completion
# binding requests during the initialization phase for lazy binding, thereby
# further speeding up Zsh startup.
#
# The real completion bindings are deferred to `-z4x-compinit`, which is called
# from inside `-z4x-post-init`. The `-z4x-post-init` hook is added to the
# `precmd_functions` array and is invoked the first time a command-line prompt
# is drawn. Because the completion system initialization is also delayed until
# this post-init phase (in `-z4x-compinit`), the built-in `compdef` is not
# available during the early initialization phase, therefore we must collect
# (register) these completion binding requests in memory now and replay them
# during the post-init phase.
#
# Arguments:
#   A list of strings that will later be passed as arguments to the built-in
#   `cmpdef` for completion bindings.
# -----------------------------------------------------------------------------
function compdef() {
  eval "$_z4x_opt"
  # Pack function arguments safely:
  #
  #   @      refer to all the arguments passed to the `compdef` command (e.g.,
  #          `compdef _ssh ssh`)
  #   j:\0:  join elements in an array into a string separated by the NULL byte
  #          (\0)
  #   p      parse escape sequences ('\0' in this case) rather than taking them
  #          as literals
  _z4x_compdef+=("${(pj:\0:)@}")
}

compdef _ssh ssh
compdef _sudo sudo

PS2=
RPS2='%F{3}%^%f'

