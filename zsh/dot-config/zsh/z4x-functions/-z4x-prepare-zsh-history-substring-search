# Prepare the zsh-history-substring-search plugin.

local pkg_dir="$ZDOTDIR/plugins/zsh-history-substring-search"

[[ -d "$pkg_dir" ]] || return

[[ "$1" == (-f|--force) ||
    ! "$pkg_dir/zsh-history-substring-search.zsh.zwc" -nt "$pkg_dir/zsh-history-substring-search.zsh" ]] \
  || return

eval "$_z4x_opt"

z4x compile -- "$ZDOTDIR/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh"

# vim:ft=zsh
