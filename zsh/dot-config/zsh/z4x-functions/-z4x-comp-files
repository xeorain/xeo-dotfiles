# Find all file completion candidates (via `-z4x-find`), present them in fzf to
# get user choice (via `-z4x-present-files` and `-z4x-fzf`).

()  {
  eval "$_z4x_opt"

  local -i dot_glob list_types
  [[ "$1" == 'on' ]] && dot_glob=1
  [[ "$2" == 'on' ]] && list_types=1

  if (( _z4x_only_dirs )); then
    local dirs=($_z4x_path_prefix${^${(Q)_z4x_words}}/*(D-/Y1N:h:t))
  else
    local dirs=($_z4x_path_prefix${^${(Q)_z4x_words}}/*(DY1N:h:t))
  fi

  -z4x-set-list-colors "$_z4x_curcontext" "$list_types"
  local -i list_colors=$((!$?))

  autoload +X -Uz -- -z4x-present-files -z4x-cursor-show -z4x-find -z4x-fzf

  local -i pct=60
  (( _z4x_can_save_restore_screen )) && pct=100

  local -i recurse
  () {
    emulate -L zsh
    # Set curcontext and dot_glob in case the value of recurse depends on them (via `zstyle -e`).
    # Ideally we should run this with user options.
    (( dot_glob )) && setopt dot_glob
    local curcontext="$_z4x_curcontext"
    zstyle -T :z4x:${WIDGET#z4x-} recurse-dirs && recurse=1
  }

  local -i height=$(( ! (recurse && ${#dirs}) && 100 * (${#_z4x_words} + 4) < pct * LINES ? ${#_z4x_words} + 4 : pct * LINES / 100 ))

  (( height >= 6 )) || (( height = 6 ))
  (( height <= LINES - 1 )) || (( height = LINES - 1 ))

  local opts=(
    --query=${_z4x_word_prefix:+"^$_z4x_word_prefix"}
    --color=hl:201,hl+:201
    --with-nth=2
    --delimiter='\000'
    --ansi
    --exact
    --no-mouse
    --tiebreak=length,begin,index
    --multi
    --cycle
    --border=horizontal
  )

  () {
    emulate -L zsh
    # Set dot_glob in case the value of find-flags depends on it (via `zstyle -e`).
    # Ideally we should run this with user options.
    (( dot_glob )) && setopt dot_glob
    local -a bin
    zstyle -a :z4x:${WIDGET#z4x-} find-command bin
    if (( ! ${#bin} )) && (( ${+commands[bfs]} )); then
      opts+=(--no-sort)
    fi
  }

  local cursor_y cursor_x
  -z4x-get-cursor-pos || return

  if (( _z4x_can_save_restore_screen )); then
    opts+=(--no-clear)
    if { (( height <= cursor_y - 1 )) && zstyle -T :z4x: prompt-at-bottom } ||
       (( cursor_y - 1 > LINES - cursor_y && cursor_y - 1 > 6 )) &&
       { (( height > LINES - cursor_y )) || zstyle -T :z4x: prompt-at-bottom }; then
      (( height <= cursor_y - 1 )) || (( height = cursor_y - 1 ))
      local move=$'\e[0m\e['$((cursor_y-height))';1H'
      opts+=(--layout=default)
    elif (( LINES - cursor_y > 6 )); then
      (( height <= LINES - cursor_y )) || (( height = LINES - cursor_y ))
      local move=$'\e[0m\n\r'
      opts+=(--layout=reverse)
    else
      local -i extra=$((height - LINES + cursor_y))
      print -rnu $_z4x_tty_fd -- "${(pl:$height::\n:)}" || return
      (( cursor_y += LINES - cursor_y - height ))
      local move=$'\e[0m\e['$((cursor_y+1))';1H'
      opts+=(--layout=reverse)
    fi
    local _z4x_saved_screen
    -z4x-save-screen || return
  else
    print -u $_z4x_tty_fd || return
    local move=
    opts+=(--layout=reverse)
  fi

  opts+=(--height="$height")

  {
    local choice
    choice="$(
      unsetopt pipe_fail
      exec 2>/dev/null
      [[ -n "$_z4x_path_prefix" ]] && builtin cd -q -- "$_z4x_path_prefix"
      {
        print -r -- "$sysparams[pid]"
        print -lr -- ${(@Q)_z4x_words}
        if (( recurse )); then
          # Set curcontext to support this:
          #
          #   zstyle -e :z4x:fzf-complete find-flags my-find-flags
          #
          #   function my-find-flags() {
          #     if [[ $curcontext == :complete:cd:* ]]; then
          #       reply=(...)
          #     fi
          #   }
          local curcontext="$_z4x_curcontext"
          -z4x-find $dot_glob $_z4x_only_dirs "${dirs[@]}" | command sed -n '/\/.*\// s/^..//p'
        fi
      } | {
        local -a pids
        IFS=' ' builtin read -rA pids || exit
        print -r -- "${pids[@]}" "$sysparams[pid]" || exit
        -z4x-present-files $list_colors $list_types 0
      } | {
        local -a pids
        IFS=' ' builtin read -rA pids || pids=()
        print -rnu $_z4x_tty_fd -- "$move"
        -z4x-cursor-show
        2>&$_z4x_tty_fd -z4x-fzf "${opts[@]}"
        (( ${#pids} )) && builtin kill -- "${pids[@]}"
      }
    )"
  } always {
    -z4x-cursor-hide
    if (( _z4x_can_save_restore_screen )); then
      -z4x-restore-screen
      print -rn -- $'\e[0m\e['$cursor_y';'$cursor_x'H'
    else
      builtin echoti cuu 1
      (( cursor_x > 1 )) && builtin echoti cuf $((cursor_x-1))
    fi
  }

  [[ -n "$choice" ]] || return
  choice=("${(@f)choice}")
  typeset -g _z4x_reply=(0 ${${choice:1}%$'\0'*})
  [[ -z "$choice[1]" ]] || _z4x_reply[1]=1
} "${options[dot_glob]}" "${options[list_types]}"

# vim:ft=zsh
