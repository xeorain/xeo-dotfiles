#!/bin/bash
# SPDX-License-Identifier: MIT
#
# A helper that streamlines xeo-dotfiles deployment.
#
# Usage:
#   Run `./setup -h` for help.
#
# Examples:
#   1. Stow all packages:
#
#       ./setup deploy -a
#
#   2. Stow packages "foo" and "bar":
#
#       ./setup deploy foo bar
#
#   3. Stow all packages except for "foo" and "bar":
#
#       ./setup deploy -a -x foo -x bar
#
#   4. Unstow all packages:
#
#       ./setup deploy -D -a
#
#   5. Unstow packages "foo" and "bar":
#
#       ./setup deploy -D foo bar
#
#   6. Unstow all packages except for "foo" and "bar":
#
#       ./setup deploy -D -a -x foo -x bar
#
#   7. Dump the current working tree into the default snapshot directory:
#
#       ./setup dump
#
#   8. Dump the 'main' branch into the default snapshot directory:
#
#       ./setup dump -c main
#
#   9. Dump commit 1234567 as a snapshot into the ~/.xeo-dotfiles directory:
#
#       ./setup dump -c 1234567 -d ~/.xeo-dotfiles
#
# Requires:   stow
#
# Copyright (c) 2026 Jerry Xeo

# Prevent the script from being sourced.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || exit

# NOTE: To maintain compatibility with Bash 3.2 on macOS when 'set -u' is
# enabled, use the following syntax patterns to index elements in an array that
# could be empty.
#
# * "${arr[1]:-}" for safely accessing a single index via a default fallback.
# * ${arr[@]+"${arr[@]}"} for safely expanding all elements via short-circuit
#   vectorization.
#
# Otherwise, Bash will crash with 'unbound variable' error when the accessed
# array is empty.
set -uo pipefail
shopt -u expand_aliases dotglob

PROGNAME="xeo-dotfiles/$(basename -- "$0")"
DOTFILES_ROOT="$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")"
readonly PROGNAME DOTFILES_ROOT
readonly DOTFILES_SNAPSHOT_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/xeo-dotfiles"

#
# Packages in the checklist require special handling.
#
# 1. Packages requiring real target directories instead of symlinks
#
# - The "gnupg" and "ssh" packages are stowed to ~/.gnupg and ~/.ssh,
#   respectively. These directories will store credentials (e.g., private keys)
#   which are not meant to be managed as dotfiles. So they have to be real
#   directory for `stow` to only stow the configuration files inside them.
# - The "zsh" package requires that a real ~/.config/zsh directory exists so
#   that it can create hidden symlinks in ~/.config/zsh to all
#   zsh/dot-config/dot-* files (e.g., ~/.config/zsh/.zshrc to
#   zsh/dot-config/zsh/dot-zshrc). On the contrary, if ~/.config/zsh doesn't
#   exist as a real directory, `stow` will create ~/.config/zsh as a symlink to
#   the zsh/dot-config/zsh directory without scanning further into it, thereby
#   no symlinks will be made for zsh/dot-config/zsh/dot-{zprofie,zshenv,zshrc}
#   files.
# - For the "systemd" package, ~/.config/systemd/user must be a real directory,
#   as it needs to hold directories dynamically generated by the execution of
#   `systemctl --user enable`, for example:
#
#       ~/.config/systemd/user/graphical-session.target.d
#       ~/.config/systemd/user/sockets.target.wants
#
#   In addition, ~/.config/systemd/user/*.d where drop-in unit files reside also
#   must be real directories.
# - Some development tools write non-configuration stuff into their
#   configuration directories, For example, `uv` saves a uv-receipt.json file in
#   the ~/.config/uv directory. If `stow` creates ~/.config/uv as a symlink,
#   then the uv-receipt.json file will actually be saved into the dotfiles
#   repository, and will even disappear together with the dotfiles whenever you
#   unstow the "uv" package.
#
# 2. Packages depending on other packages (missing package check required)
#
# - The "bash" package depends on packages "shell" and "readline". Either of
#   them needs to be manually added along with "bash" if missing. The "readline"
#   package also needs to be unstowed whenever "bash" is unstowed. Similarly,
#   the "zsh" package depends on the "shell" package.
# - The "git" package depends on the "delta" package for diff highlighting.
# - The "i3status-rust" package depends on some programs delivered by the
#   "xeo-utils-desktop" package.
# - The "sway" package depends on the "i3status-rust" package and some helper
#   scripts in the "xeo-utils-desktop" package.
#
# 3. Packages requiring theme activation
#
# - Some Packages (e.g., "delta", "foot") provide multiple theme files, and
#   require a theme to be activated by creating a symlink in each of their
#   configuration directories pointing to the desired theme file.
#
# 4. Misc.
#
# - The "xeo-utils-desktop" package requires a symlink named in the form of
#   xeo-udiskie-<launcher> pointing to xeo-udiskie-dmenu so that the program can
#   run with a spcified application launcher.
# - The "ghostty" package requires a symlink `ostype.conf` pointing to either
#   linux.conf or macos.conf depending on the host OS.
readonly PKG_CHECKLIST_STOW=(
  'bash' 'bat' 'delta' 'foot' 'ghostty' 'git' 'gnupg' 'go' 'i3status-rust'
  'kitty' 'npm' 'pip' 'sway' 'systemd' 'uv' 'xeo-utils-desktop' 'zsh'
)
readonly PKG_CHECKLIST_UNSTOW=(
  'bash' 'bat' 'delta' 'foot' 'ghostty' 'gnupg' 'go' 'i3status-rust' 'npm' 'pip'
  'readline' 'shell' 'systemd' 'uv' 'xeo-utils-desktop' 'zsh'
)

tgt_root="${HOME}"

in_select_menu=0

stow_cmd_args=('--dotfiles')
added_pkgs_cache=$'\n'
added_pkgs=()
missing_pkgs=()
recommended_pkgs=()
pkgs_need_postproc=()


print_hint() {
  printf "Try '%s -h' for more information\n" "${PROGNAME}"
}

say() {
  printf "\033[1m%s:\033[0m %b\n" "${PROGNAME}" "$1"
}

say_err() {
  printf "\033[1m%s:\033[0m \033[1;31merror:\033[0m %b\n" "${PROGNAME}" "$1" >&2
}

pkg_say() {
  printf "\033[1m%s:\033[0m \033[1;32m[%s]\033[0m %b\n" "${PROGNAME}" "$1" "$2"
}

pkg_say_err() {
  printf "\033[1m%s:\033[0m \033[1;31m[%s]\033[0m %b\n" "${PROGNAME}" "$1" "$2" >&2
}

die() {
  say_err "$1"
  exit "${2:-1}"
}

die_with_hint() {
  say_err "$1"
  print_hint >&2
  exit "${2:-1}"
}

# -----------------------------------------------------------------------------
# Remove duplicate elements in an array in-place.
#
# NOTE: The reason for intentionally using a nested loop instead of an
# associative array for duplication check is to maintain compatibility with Bash
# v3.2 which is still used on macOS.
#
# Arguments:
#   $1: The target array name.
#   ${@:2}: A list of items in the original array.
# -----------------------------------------------------------------------------
dedup_array() {
  local _arr_name="$1"
  local -a _result
  local _x _y

  for _x in "${@:2}"; do
    for _y in ${_result[@]+"${_result[@]}"}; do
      [[ "${_y}" == "${_x}" ]] && continue 2
    done
    _result+=("${_x}")
  done

  if [[ ${#_result[@]} -gt 0 ]]; then
    eval "${_arr_name}"'=("${_result[@]}")'
  fi
}

# -----------------------------------------------------------------------------
# Ensure a directory exists.
#
# Arguments:
#   A string representing the path to the target directory.
#
# Returns:
#   0 if the directory already exists or is created successfully; non-zero on
#   manual cancellation or errors.
# -----------------------------------------------------------------------------
checkdir() {
  local _dir="$1"
  local _ret=0

  if [[ -e "${_dir}" ]]; then
    [[ -d "${_dir}" ]] || die "non-directory path '${_dir}' already exists"
  else
    local _first_prompt=1
    local _ans
    while true; do
      if [[ "${_first_prompt}" = 1 ]]; then
        _first_prompt=0
      else
        printf '\033[1A\033[K'
      fi
      read -rp "Directory '${_dir}' does not exist. Create it to proceed? (Y/n): " _ans
      case "${_ans}" in
        n|N)
          say 'cancelled by user'
          _ret=1
          break
          ;;
        ''|y|Y)
          mkdir -p "${_dir}" || _ret=$?
          break
          ;;
        *)
          printf 'Invalid input. Please try again!\n' >&2
          ;;
      esac
    done
  fi

  return "${_ret}"
}

# -----------------------------------------------------------------------------
# Create a directory with given permissions.
#
# Arguments:
#   $1: A string representing the absolute path to the target directory.
#   $2: (Optional) A string representing the octal permissions (e.g., 700).
#
# Returns:
#   0 if the directly already exists or is created successfully; non-zero on
#   errors.
# -----------------------------------------------------------------------------
makedir() {
  local _dir="$1"
  local _perm="${2:-}"
  local _ret=0
  if ! [[ -e "${_dir}" ]]; then # non-existent, create it
    if ! mkdir ${_perm:+-m "${_perm}"} -p "${_dir}" 2>/dev/null; then
      _ret=$?
      say_err "failed to create target directory '${_dir}'"
    fi
  elif ! [[ -d "${_dir}" ]]; then # existing, but not a directory
    _ret=1
    say "non-directory path '${_dir}' already exists"
  fi
  return "${_ret}"
}

# -----------------------------------------------------------------------------
# Remove an empty directory for a package.
#
# Globals:
#   in_select_menu
#
# Arguments:
#   $1: A string representing the path to the target directory.
#   $2: A string representing the package being processed.
#
# Returns:
#   0 on if removal succeeds or the directory is not empty; non-zero on errors.
# -----------------------------------------------------------------------------
remove_empty_dir() {
  local _ret=0
  local _dir="$1"
  local _pkg="$2"

  [[ -d "${_dir}" ]] || return 0
  # Check if the directory is empty.
  [[ -z "$(find "${_dir}" -mindepth 1 -maxdepth 1 -print -quit)" ]] || return 0

  local _first_prompt=1
  local _ans

  in_select_menu=1
  while true; do
    if [[ "${_first_prompt}" = 1 ]]; then
      _first_prompt=0
    else
      # Rewrite the prompt at the same line.
      # * \033[1A moves cursor 1 line up.
      # * \033[K clear the text from the cursor position to the end of the
      #   current line.
      printf '\033[1A\033[K'
    fi
    printf '>>> %b' "\033[1m${_pkg}\033[0m now has an empty installation directory '${_dir}'. Remove it? (y/N): "
    read -r _ans
    case "${_ans}" in
      y|Y)
        rmdir "${_dir}" || _ret=$?
        break
        ;;
      ''|n|N)
        break
        ;;
    esac
  done
  in_select_menu=0

  return ${_ret}
}

# -----------------------------------------------------------------------------
# Process mandatory dependencies between dotfile packages, prompting users to
# decide whether to stow missing packages required by the package requested
# to be stowed, or to unstow other packages depending on the package requested
# to be unstowed.
#
# Globals:
#   added_pkgs
#   added_pkgs_cache
#   in_select_menu
#
# Arguments:
#   $1: A string indicating operation mode, either '-i' (for install) or '-u'
#     (for uninstall).
#   $2: A string representing the depender package.
#   ${@:3}: A list of strings representing the dependee packages.
#
# Returns:
#   0 if dependencies are accepted, 1 otherwise.
# -----------------------------------------------------------------------------
proc_pkg_mand_deps() {
  local _mode="$1"
  local _depender="$2"
  local _dependee
  local _needed_pkgs=()

  for _dependee in "${@:3}"; do
    [[ "${added_pkgs_cache}" == *$'\n'"${_dependee}"$'\n'* ]] && continue
    _needed_pkgs+=("${_dependee}")
  done

  [[ ${#_needed_pkgs[@]} -eq 0 ]] && return 0

  pkg_say "${_depender}" 'processing mandatory dependencies with other packages'

  local _joined_needed_pkgs
  printf -v _joined_needed_pkgs '\033[1m%s\033[0m, ' "${_needed_pkgs[@]}"
  _joined_needed_pkgs="${_joined_needed_pkgs%, }"

  local _approved=0
  local _first_prompt=1
  local _ans

  in_select_menu=1
  case "${_mode}" in
    -i)
      while true; do
        if [[ "${_first_prompt}" = 1 ]]; then
          _first_prompt=0
        else
          printf '\033[1A\033[K'
        fi
        printf '>>> %b' "\033[1m${_depender}\033[0m \033[35mrequires\033[0m ${_joined_needed_pkgs}. Install them all together? (Y/n): "
        read -r _ans
        case "${_ans}" in
          ''|y|Y)
            _approved=1
            break
            ;;
          n|N)
            # It is an error to refuse to install a dependee package.
            pkg_say_err "${_depender}" 'installation cancelled due to unmet dependencies'
            in_select_menu=0
            return 1
            ;;
        esac
      done
      ;;
    -u)
      while true; do
        if [[ "${_first_prompt}" = 1 ]]; then
          _first_prompt=0
        else
          printf '\033[1A\033[K'
        fi
        printf '>>> %b' "\033[1m${_depender}\033[0m \033[35mbreaks\033[0m ${_joined_needed_pkgs}. Uninstall them all together? (Y/n): "
        read -r _ans
        case "${_ans}" in
          ''|y|Y)
            _approved=1
            break
            ;;
          n|N)
            # It is an error to refuse to install a dependee package.
            pkg_say_err "${_depender}" "uninstallation is cancelled to avoid breaking ${_joined_needed_pkgs}"
            in_select_menu=0
            return 1
            ;;
        esac
      done
      ;;
  esac
  in_select_menu=0

  if [[ "${_approved}" == 1 ]]; then
    added_pkgs+=("${_needed_pkgs[@]}")
    for _dependee in "${_needed_pkgs[@]}"; do
      added_pkgs_cache="${added_pkgs_cache}${_dependee}"$'\n'
      # Missing (required) packages that require post-processing:
      # * Packages with real directories
      # * Packages with activated themes (delta)
      # * Packages with special symlinks (xeo-utils-desktop)
      if [[ "${_mode}" == '-i' ]]; then
        case "${_dependee}" in
          delta|xeo-utils-desktop)
            pkgs_need_postproc+=("${_dependee}")
            ;;
        esac
      else
        case "${_dependee}" in
          bash)
            pkgs_need_postproc+=("${_dependee}")
            ;;
        esac
      fi
    done
  fi

  return 0
}

# -----------------------------------------------------------------------------
# Process weak dependencies between dotfile packages, prompting users to decide
# whether to stow other packages recommended by the package requested to be
# stowed, or to unstow other packages that take the package requested to be
# unstowed as weak dependencies.
#
# Globals:
#   added_pkgs
#   added_pkgs_cache
#   in_select_menu
#
# Arguments:
#   $1: A string indicating operation mode, either '-i' (for install) or '-u'
#     (for uninstall).
#   $2: A string representing the depender package
#   ${@:3}: A list of strings representing the dependee packages.
# -----------------------------------------------------------------------------
proc_pkg_weak_deps() {
  local _mode="$1"
  local _depender="$2"
  local _dependee
  local _approved=0
  local _first_prompt _ans

  pkg_say "${_depender}" 'processing weak dependencies with other packages'

  for _dependee in "${@:3}"; do
    [[ "${added_pkgs_cache}" == *$'\n'"${_dependee}"$'\n'* ]] && continue
    _first_prompt=1
    in_select_menu=1
    case "${_mode}" in
      -i)
        while true; do
          if [[ "${_first_prompt}" = 1 ]]; then
            _first_prompt=0
          else
            printf '\033[1A\033[K'
          fi
          printf '>>> %b' "\033[1m${_depender}\033[0m \033[35mrecommends\033[0m \033[1m${_dependee}\033[0m. Install \033[1m${_dependee}\033[0m together? (Y/n): "
          read -r _ans
          case "${_ans}" in
            ''|y|Y)
              _approved=1
              break
              ;;
            n|N)
              break
              ;;
          esac
        done
        ;;
      -u)
        if [[ "${_first_prompt}" = 1 ]]; then
          _first_prompt=0
        else
          printf '\033[1A\033[K'
        fi
        while true; do
          printf '>>> %b' "\033[1m${_depender}\033[0m may \033[35mdegrade\033[0m \033[1m${_dependee}\033[0m. Uninstall \033[1m${_dependee}\033[0m together? (y/N): "
          read -r _ans
          case "${_ans}" in
            y|Y)
              _approved=1
              break
              ;;
            ''|n|N)
              break
              ;;
          esac
        done
        ;;
    esac
    in_select_menu=0
    if [[ "${_approved}" == 1 ]]; then
      _approved=0
      added_pkgs_cache="${added_pkgs_cache}${_dependee}"$'\n'
      added_pkgs+=("${_dependee}")
      # Recommended packages that require post-processing:
      # * Packages with real directories (bash, zsh)
      # * Packages with activated themes
      # * Packages with special symlinks
      if [[ "${_mode}" == '-u' ]]; then
        case "${_dependee}" in
          bash|zsh)
            pkgs_need_postproc+=("${_dependee}")
            ;;
        esac
      fi
    fi
  done
}

# -----------------------------------------------------------------------------
# Check whether the packages to be stowed are in the checklist, and perform
# corresponding pre-processing on them.
#
# Globals:
#   PKG_CHECKLIST_STOW
#   config_root
#   missing_pkgs
#   pkgs_need_postproc
#   recommended_pkgs
#   tgt_root
#
# Arguments:
#   A list of strings representing packages to stow.
#
# Returns:
#   0 if pre-processing on all packages succeeds; non-zero otherwise.
# -----------------------------------------------------------------------------
preproc_for_stow() {
  local _joined_pkgs
  # PERF: Join all package names from an array into a newline-separated string
  # so that we can determine whether a package in the checklist is requested to
  # be stowed by using substring matching instead of looping over an array.
  _joined_pkgs=$'\n'"$(printf '%s\n' "$@")"$'\n'

  local _p
  for _p in "${PKG_CHECKLIST_STOW[@]}"; do
    if [[ "${_joined_pkgs}" == *$'\n'"${_p}"$'\n'* ]]; then
      case "${_p}" in
        bash)
          makedir "${config_root}/${_p}" || return $?
          # Ensure 'readline' stowed together with 'bash'.
          [[ "${_joined_pkgs}" == *$'\n'readline$'\n'* ]] \
            || missing_pkgs+=("${_p}"$'\t''readline')
          # Recommend 'shell' for 'bash'.
          [[ "${_joined_pkgs}" == *$'\n'shell$'\n'* ]] \
            || recommended_pkgs+=("${_p}"$'\t''shell')
          [[ "${_joined_pkgs}" == *$'\n'xeo-utils-extra$'\n'* ]] \
            || recommended_pkgs+=("${_p}"$'\t''xeo-utils-extra')
          ;;
        bat|delta|xeo-utils-desktop|foot|ghostty|kitty)
          pkgs_need_postproc+=("${_p}")
          ;;
        git)
          [[ "${_joined_pkgs}" == *$'\n'delta$'\n'* ]] \
            || missing_pkgs+=("${_p}"$'\t''delta')
          ;;
        i3status-rust)
          [[ "${_joined_pkgs}" == *$'\n'xeo-utils-desktop$'\n'* ]] \
            || missing_pkgs+=("${_p}"$'\t''xeo-utils-desktop')
          ;;
        gnupg)
          makedir "${tgt_root}/.${_p}" '700' || return 1
          chmod 600 "${DOTFILES_ROOT}/gnupg/dot-gnupg/gpg-agent.conf"
          ;;
        sway)
          # Ensure 'xeo-utils-desktop' and 'i3status-rust' stowed together with
          # 'sway'.
          local _missing="${_p}"
          [[ "${_joined_pkgs}" == *$'\n'xeo-utils-desktop$'\n'* ]] \
            || _missing+=$'\t''xeo-utils-desktop'
          [[ "${_joined_pkgs}" == *$'\n'i3status-rust$'\n'* ]] \
            || _missing+=$'\t''i3status-rust'
          [[ "${_missing}" == 'sway' ]] || missing_pkgs+=("${_missing}")
          ;;
        systemd)
          makedir "${config_root}/${_p}/user"
          # NOTE: Directories containing systemd drop-in files (i.e.,
          # ~/.config/systemd/user/*.d) must be REAL directories rather than
          # symlinks.
          # See https://unix.stackexchange.com/questions/794558/systemd-resolved-configuration-not-working
          local _d
          for _d in ./systemd/dot-config/systemd/user/*.d; do
            if [[ -d "${_d}" ]]; then
              _d="${config_root}/${_d##*dot-config/}"
              makedir "${_d}" || return $?
            fi
          done
          ;;
        zsh)
          # Ensure "shell" is installed along with "zsh".
          makedir "${config_root}/${_p}" || return $?
          pkgs_need_postproc+=("${_p}")
          # Recommend 'shell' for 'bash'.
          [[ "${_joined_pkgs}" == *$'\n'shell$'\n'* ]] \
            || recommended_pkgs+=("${_p}"$'\t''shell')
          [[ "${_joined_pkgs}" == *$'\n'xeo-utils-extra$'\n'* ]] \
            || recommended_pkgs+=("${_p}"$'\t''xeo-utils-extra')
          ;;
        go|npm|pip|uv)
          makedir "${config_root}/${_p}" || return $?
          ;;
      esac
    fi
  done

  [[ ${#pkgs_need_postproc[@]} -gt 0 ]] \
    && dedup_array 'pkgs_need_postproc' "${pkgs_need_postproc[@]}"

  # Process dependencies between dotfile packages.
  local _item
  local -a _pkgs

  for _item in ${missing_pkgs[@]+"${missing_pkgs[@]}"}; do
    IFS=$'\t' read -r -a _pkgs <<<"${_item}"
    proc_pkg_mand_deps -i "${_pkgs[@]}" || return $?
  done

  for _item in ${recommended_pkgs[@]+"${recommended_pkgs[@]}"}; do
    IFS=$'\t' read -r -a _pkgs <<<"${_item}"
    proc_pkg_weak_deps -i "${_pkgs[@]}"
  done

  return 0
}

# -----------------------------------------------------------------------------
# Pre-process the 'xeo-utils-desktop' package before unstow.
#
# * Remove symlink ${bin_root}/xeo-udiskie-<launcher>
#
# Globals:
#   bin_root
#
# Arguments:
#   None
#
# Returns:
#   0 on pre-processing success; non-zero on errors.
# -----------------------------------------------------------------------------
preproc_xeo-utils-desktop_unstow() {
  local _launchers=('bemenu' 'fuzzel' 'rofi' 'wmenu' 'wofi')
  local _launcher _link

  for _launcher in "${_launchers[@]}"; do
    _link="${bin_root}/xeo-udiskie-${_launcher}"
    if [[ -L "${_link}" && "$(readlink "${_link}")" == 'xeo-udiskie-dmenu' ]]; then
      rm -f "${_link}" || return $?
    fi
  done

  return 0
}

# -----------------------------------------------------------------------------
# Pre-process the 'ghostty' package before unstow.
#
# * Remove symlink ${config_root}/ghostty/ostype.conf
#
# Globals:
#   config_root
#
# Arguments:
#   None
#
# Returns:
#   0 on pre-processing success; non-zero on errors.
# -----------------------------------------------------------------------------
preproc_ghostty_unstow() {
  local _link="${config_root}/ghostty/ostype.conf"
  [[ ! -L "${_link}" ]] || rm -f "${_link}"
}

# -----------------------------------------------------------------------------
# Pre-process the 'zsh' package before unstow.
#
# * Remove symlink ${tgt_root}/.zshenv
#
# Globals:
#   config_root
#   tgt_root
#
# Arguments:
#   None
#
# Returns:
#   0 on pre-processing success; non-zero on errors.
# -----------------------------------------------------------------------------
preproc_zsh_unstow() {
  local _zshenv_link="${HOME}/.zshenv"
  local _zshenv_relpath="${config_root#"${tgt_root}"/}/zsh/.zshenv"

  if [[ -L "${_zshenv_link}" \
      && "$(readlink "${_zshenv_link}")" == "${_zshenv_relpath}" ]]; then
    rm -f "${_zshenv_link}" || return $?
  fi

  return 0
}

# -----------------------------------------------------------------------------
# Remove package current theme symlinks.
#
# Globals:
#   config_root
#
# Arguments:
#   A string representing the package name.
#
# Returns:
#   0 on success; non-zero on errors.
# -----------------------------------------------------------------------------
unlink_pkg_current_themes() {
  local _ret=0

  case "$1" in
    delta)
      [[ ! -L "${config_root}/delta/current-theme.gitconfig" ]] \
        || rm -f "${config_root}/delta/current-theme.gitconfig" || _ret=$?
      ;;
    foot)
      [[ ! -L "${config_root}/foot/current-theme-dark.ini" ]] \
        || rm -f "${config_root}/foot/current-theme-dark.ini" || _ret=$?
      [[ ! -L "${config_root}/foot/current-theme-light.ini" ]] \
        || rm -f "${config_root}/foot/current-theme-light.ini" || _ret=$?
      ;;
  esac

  return ${_ret}
}

# -----------------------------------------------------------------------------
# Check whether the packages to be unstowed are in the checklist, and perform
# corresponding pre-processing on them.
#
# Globals:
#   PKG_CHECKLIST_UNSTOW
#   config_root
#   missing_pkgs
#   recommended_pkgs
#   tgt_root
#
# Arguments:
#   A list of strings representing packages to unstow.
#
# Returns:
#   0 if pre-processing on all packages succeeds; non-zero otherwise.
# -----------------------------------------------------------------------------
preproc_for_unstow() {
  local _joined_pkgs
  # PERF: Join all package names from an array into a newline-separated string
  # so that we can determine whether a package in the checklist is requested to
  # be unstowed by using substring matching instead of looping over an array.
  _joined_pkgs=$'\n'"$(printf '%s\n' "$@")"$'\n'

  local _p
  for _p in "${PKG_CHECKLIST_UNSTOW[@]}"; do
    if [[ "${_joined_pkgs}" == *$'\n'"${_p}"$'\n'* ]]; then
      case "${_p}" in
        xeo-utils-desktop)
          "preproc_${_p}_unstow" || return $?
          [[ "${_joined_pkgs}" == *$'\n'i3status-rust$'\n'* ]] \
            || missing_pkgs+=('xeo-utils-desktop'$'\t''i3status-rust')
          [[ "${_joined_pkgs}" == *$'\n'sway$'\n'* ]] \
            || missing_pkgs+=('xeo-utils-desktop'$'\t''sway')
          ;;
        ghostty)
          "preproc_${_p}_unstow" || return $?
          ;;
        gnupg)
          pkgs_with_postproc+=("${_p}")
          ;;
        i3status-rust)
          [[ "${_joined_pkgs}" == *$'\n'sway$'\n'* ]] \
            || missing_pkgs+=('i3status-rust'$'\t''sway')
          ;;
        readline)
          [[ "${_joined_pkgs}" == *$'\n'bash$'\n'* ]] \
            || missing_pkgs+=('readline'$'\t''bash')
          ;;
        shell)
          local _rec='shell'
          [[ "${_joined_pkgs}" == *$'\n'bash$'\n'* ]] || _rec+=$'\t''bash'
          [[ "${_joined_pkgs}" == *$'\n'zsh$'\n'* ]] || _rec+=$'\t''zsh'
          [[ "${_rec}" == 'shell' ]] || recommended_pkgs+=("${_rec}")
          ;;
        zsh)
          "preproc_${_p}_unstow" || return $?
          pkgs_need_postproc+=("${_p}")
          ;;
        bash|go|npm|pip|systemd|uv)
          pkgs_need_postproc+=("${_p}")
          ;;
        delta|foot)
          unlink_pkg_current_themes "${_p}" || return $?
          ;;
      esac
    fi
  done

  local -a _pkgs
  local _item

  # Process mandatory dependencies between dotfile packages.
  for _item in ${missing_pkgs[@]+"${missing_pkgs[@]}"}; do
    IFS=$'\t' read -r -a _pkgs <<<"${_item}"
    proc_pkg_mand_deps -u "${_pkgs[@]}" || return $?
  done

  # Process weak dependencies between dotfile packages.
  for _item in ${recommended_pkgs[@]+"${recommended_pkgs[@]}"}; do
    IFS=$'\t' read -r -a _pkgs <<<"${_item}"
    proc_pkg_weak_deps -u "${_pkgs[@]}"
  done

  return 0
}

# -----------------------------------------------------------------------------
# Activate a color theme for a package.
#
# Globals:
#   config_root
#   in_select_menu
#   old_ps3
#
# Arguments:
#   $1: A string representing the package name.
#   $2: A string representing the theme file extension.
#   $3: (Optional) A string representing the theme style, either 'dark' or
#     'light'.
#
# Returns:
#   0 on them activation success; 1 on errors.
# -----------------------------------------------------------------------------
activate_pkg_theme() {
  local _pkg="$1"
  local _ext="$2"
  local _style="${3:-}"

  local _ret=0
  local _pkg_config_dir="${config_root}/${_pkg}"
  local _pkg_theme_link="${_pkg_config_dir}/current-theme${_style:+"-${_style}"}.${_ext}"

  # Return early if both the symlink and the target exist.
  [[ -L "${_pkg_theme_link}" && -e "${_pkg_theme_link}" ]] && return 0

  # Collect all theme files from the package themes directory.
  # NOTE: To maintain the compatibility with BSD `find` on macOS:
  # * Use the `-H` option to force BSD `find` to follow symlinks passed as
  #   command-line arguments (e.g., `${_pkg_config_dir}/themes` in our case)
  # * Use `-exec basename` to invoke the external `basename` command instead of
  #   GNU-specific `-printf "%f\n"` option to extract filename from the pathname
  #   of a theme file found by `find`.
  local _line
  local _theme_files=()
  while IFS= read -r _line; do
    [[ -n "${_line:-}" ]] && _theme_files+=("${_line%."${_ext}"}")
  done < <(find -H "${_pkg_config_dir}/themes" -maxdepth 1 -type f -exec basename {} \; | LC_ALL=C sort -f)

  if [[ ${#_theme_files[@]} -eq 0 ]]; then
    pkg_say_err "${_pkg}" 'no color themes found'
    return 1
  fi

  pkg_say "${_pkg}" "select a${_style:+ \033[1m"${_style}"\033[0m} theme"

  in_select_menu=1
  [[ "${PS+1}" == '1' ]] && old_ps3="${PS3}"
  PS3='Please enter the number of your choice (0 to quit): '

  printf "0) Quit\n"
  local _f
  select _f in "${_theme_files[@]}"; do
    [[ "${REPLY}" == '0' ]] && break
    if [[ -n "${_f:-}" ]]; then
      if ln -sf "themes/${_f}.${_ext}" "${_pkg_theme_link}"; then
        pkg_say "${_pkg}" "color theme \033[1m${_f%."${_ext}"}\033[0m activated"
      else
        _ret=$?
        pkg_say_err "${_pkg}" "failed to activate color theme '\033[1m${_f%."${_ext}"}\033[0m'"
      fi
      break
    else
      printf 'Invalid choice. Please try again!\n' >&2
    fi
  done

  if [ "${old_ps3+1}" == '1' ]; then
    PS3="${old_ps3}"
    unset old_ps3
  else
    unset PS3
  fi
  in_select_menu=0

  return "${_ret}"
}

# -----------------------------------------------------------------------------
# Post-process the 'xeo-utils-desktop' package after stow.
#
# Globals:
#   bin_root
#   in_select_menu
#   old_ps3
#
# Arguments:
#   None
#
# Returns:
#   0 on post-processing success; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_xeo-utils-desktop_stow() {
  local _ret=0
  local -r _launchers=('bemenu' 'fuzzel' 'rofi' 'wmenu' 'wofi')

  pkg_say 'xeo-utils-desktop' 'postprocessing'

  in_select_menu=1
  [[ "${PS3+1}" == '1' ]] && old_ps3="${PS3}"
  PS3="Please enter the number of your choice (0 to quit): "

  pkg_say 'xeo-utils-desktop' 'select application launcher for xeo-udiskie-dmenu'
  printf "0) Quit\n"
  select _launcher in "${_launchers[@]}"; do
    [[ "${REPLY}" == '0' ]] && break
    if [[ -n "${_launcher:-}" ]]; then
      local _link="${bin_root}/xeo-udiskie-${_launcher}"
      [[ -L "${_link}" && "$(readlink "${_link}")" == 'xeo-udiskie-dmenu' ]] \
        && break
      if ln -sf 'xeo-udiskie-dmenu' "${_link}"; then
        pkg_say 'xeo-utils-desktop' "set launcher to \033[1m${_launcher}\033[0m for xeo-udiskie-dmenu"
      else
        _ret=$?
        pkg_say_err 'xeo-utils-desktop' 'failed to set launcher for xeo-udiskie-dmenu'
      fi
      break
    else
      printf 'Invalid choice. Please try again!\n' >&2
    fi
  done

  if [ "${old_ps3+1}" == '1' ]; then
    PS3="${old_ps3}"
    unset old_ps3
  else
    unset PS3
  fi
  in_select_menu=0

  [[ "${_ret}" -eq 0 ]] && pkg_say 'xeo-utils-desktop' 'postprocssing complete'

  return "${_ret}"
}

# -----------------------------------------------------------------------------
# Post-process the 'ghostty' package after stow.
#
# * Symlink "${config_dir}/ghostty/ostype.conf" to either linux.conf or
#   macos.conf
#
# Globals:
#   config_root
#
# Arguments:
#   None
#
# Returns:
#   0 on post-processing success; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_ghostty_stow() {
  local _link="${config_root}/ghostty/ostype.conf"
  local _ostype

  case "${OSTYPE:-}" in
    darwin*)
      _ostype='macos'
      ;;
    linux*)
      _ostype='linux'
      ;;
    *)  # unsupported platform
      return 0
  esac

  # Return early if the symlink target doesn't exist.
  ! [[ -e "${config_root}/ghostty/${_ostype}.conf" ]] && return
  # Return early if the symlink exists with the expected target.
  [[ -L "${_link}" && "$(readlink "${_link}")" == "${_ostype}.conf" ]] && return

  pkg_say 'ghostty' 'start post-procssing'

  if [[ -L "${_link}" ]]; then  # symlink exists with unexpected target
    pkg_say_err 'ghostty' "unmatched symlink '${_link}' exits; please remove or back it up, then stow 'ghostty' again."
    return 1
  elif [[ -e "${_link}" ]]; then  # non-symlink file exists
    pkg_say_err 'ghostty' "file '${_link}' exits; please remove or back it up, then stow 'ghostty' again."
    return 1
  else
    ln -s "${_ostype}.conf" "${_link}"  || return $?
  fi

  pkg_say 'ghostty' 'postprocssing complete'

  return 0
}

# -----------------------------------------------------------------------------
# Post-process the 'zsh' package after stow.
#
# * Symlink ~/.zshenv to "${config_root}/zsh/.zshenv"
#
# Globals:
#   config_root
#   tgt_root
#
# Arguments:
#   None
#
# Returns:
#   0 on post-processing success; non-zero otherwise .
# -----------------------------------------------------------------------------
postproc_zsh_stow() {
  local _zshenv_link="${HOME}/.zshenv"
  local _zshenv_tgt="${config_root}/zsh/.zshenv"

  # Return early if the symlink target doesn't exist.
  [[ -e "${_zshenv_tgt}" ]] || return 0
  # Use relative path for symlink target.
  _zshenv_tgt="${_zshenv_tgt#"${tgt_root}/"}"
  # Return if symlink exists with expected target.
  [[ -L "${_zshenv_link}" && "$(readlink "${_zshenv_link}")" == "${_zshenv_tgt}" ]] \
    && return 0

  pkg_say 'zsh' 'start postprocssing'

  if [[ -L "${_zshenv_link}" ]]; then  # symlink exists with unexpected target
    pkg_say_err 'zsh' "unexpected symlink '${_zshenv_link}' exits. Please remove or back it up, then stow 'zsh' again."
    return 1
  elif [[ -e "${_zshenv_link}" ]]; then  # non-symlink exists
    pkg_say_err 'zsh' "file '${_zshenv_link}' exits. please remove or back it up, then install 'zsh' again."
    return 1
  else
    ln -s "${_zshenv_tgt}" "${_zshenv_link}" || return $?
  fi

  pkg_say 'zsh' 'postprocssing complete'

  return 0
}

# -----------------------------------------------------------------------------
# Post-process the 'bat' package for stow.
#
# Returns:
#   0 on post-processing success; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_bat_stow() {
  pkg_say 'bat' 'postprocessing'
  if bat cache --build >/dev/null 2>&1; then
    pkg_say 'bat' 'postprocessing complete'
    return 0
  else
    pkg_say 'bat' 'error building theme cache'
    return 1
  fi
}

# -----------------------------------------------------------------------------
# Post-process the 'delta' package after stow.
#
# * Activate default theme
#
# Returns:
#   0 on post-processing success; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_delta_stow() {
  pkg_say 'delta' 'postprocessing'
  if activate_pkg_theme 'delta' 'gitconfig'; then
    pkg_say 'delta' 'postprocessing complete'
    return 0
  else
    return $?
  fi
}

# -----------------------------------------------------------------------------
# Post-process the 'foot' package after stow.
#
# * Activate default theme
#
# Returns:
#   0 on post-processing success; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_foot_stow() {
  local _ret=0
  pkg_say 'foot' 'postprocessing'
  activate_pkg_theme 'foot' 'ini' 'dark' || _ret=$?
  activate_pkg_theme 'foot' 'ini' 'light' || _ret=$?
  [[ "${_ret}" -eq 0 ]] && pkg_say 'foot' 'postprocessing complete'
  return "${_ret}"
}

# -----------------------------------------------------------------------------
# Post-process the 'kitty' package after stow.
#
# * Generate theme-loader.conf
#
# Globals:
#   config_root
#
# Returns:
#   0 on post-processing success; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_kitty_stow() {
  pkg_say 'kitty' 'postprocessing'
  cat  << 'EOF' >"${config_root}/kitty/theme-loader.conf" || return $?
# BEGIN_KITTY_THEME
include current-theme.conf
# END_KITTY_THEME
EOF
  pkg_say 'kitty' 'postprocessing'
  return 0
}

# -----------------------------------------------------------------------------
# Post-process all packages after stow.
#
# Globals:
#   pkgs_need_postproc
#
# Arguments:
#   None
#
# Returns:
#   0 if post-processing on all packages succeeds; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_for_stow() {
  local _ret=0
  local _p

  for _p in ${pkgs_need_postproc[@]+"${pkgs_need_postproc[@]}"}; do
    "postproc_${_p}_stow" || _ret=$?
  done

  return "${_ret}"
}

# -----------------------------------------------------------------------------
# Post-process the 'zsh' package after unstow.
#
# * Clear .zwc files.
#
# Globals:
#   config_root
#
# Returns:
#   0 on post-processing success; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_zsh_unstow() {
  local _zsh_config_dir="${config_root}/zsh"
  [[ -d "${_zsh_config_dir}" ]] || return 0
  find "${_zsh_config_dir}" -name '*.zwc' -delete >/dev/null 2>&1
}

# -----------------------------------------------------------------------------
# Post-process all packages after unstow.
#
# Globals:
#   config_root
#   pkgs_need_postproc
#   tgt_root
#
# Arguments:
#   None
#
# Returns:
#   0 if post-processing on all packages succeeds; non-zero otherwise.
# -----------------------------------------------------------------------------
postproc_for_unstow() {
  local _ret=0

  for _p in ${pkgs_need_postproc[@]+"${pkgs_need_postproc[@]}"}; do
    pkg_say "${_p}" 'postprocessing'
    case "${_p}" in
      bash|go|npm|pip|uv)
        remove_empty_dir "${config_root}/${_p}" "${_p}" || _ret=$?
        ;;
      bat)
        [[ -d "${config_root}/bat/themes" ]] \
          || bat cache --clear >/dev/null 2>&1 \
          || _ret=$?
        ;;
      gnupg)
        remove_empty_dir "${tgt_root}/.${_p}" "${_p}" || _ret=$?
        ;;
      systemd)
        local _d
        for _d in ./systemd/dot-config/systemd/user/*.d; do
          if [[ -d "${_d}" ]]; then
            _d="${config_root}/${_d##*dot-config/}"
            remove_empty_dir "${_d}" "${_p}" || _ret=$?
          fi
        done
        ;;
      zsh)
        postproc_zsh_unstow || _ret=$?
        remove_empty_dir "${config_root}/${_p}" "${_p}" || _ret=$?
        ;;
    esac
  done

  return "${_ret}"
}

# -----------------------------------------------------------------------------
# Stow requested packages.
#
# Globals:
#   added_pkgs
#   bin_root
#   config_root
#   libexec_root
#   stow_cmd_args
#   tgt_root
#
# Arguments:
#   A list of strings representing the packages requested to be stowed.
#
# Returns:
#   0 if stow succeeds; non-zero otherwise.
# -----------------------------------------------------------------------------
do_stow() {
  checkdir "${config_root}" || return $?
  checkdir "${bin_root}" || return $?
  checkdir "${libexec_root}" || return $?

  preproc_for_stow "$@" || return $?
  [[ ${#added_pkgs[@]} -gt 0 ]] && set -- "$@" "${added_pkgs[@]}"

  stow "${stow_cmd_args[@]}" -S "$@" || return $?
  postproc_for_stow
}

# -----------------------------------------------------------------------------
# Unstow requested packages.
#
# Globals:
#   stow_cmd_args
#   tgt_root
#
# Arguments:
#   A list of strings representing the packages requested to be unstowed.
#
# Returns:
#   0 if unstow succeeds; non-zero otherwise.
# -----------------------------------------------------------------------------
do_unstow() {
  preproc_for_unstow "$@" || return $?
  [[ ${#added_pkgs[@]} -gt 0 ]] && set -- "$@" "${added_pkgs[@]}"

  # NOTE: Unstow packages individually to avoid a stow planning inconsistency
  # when multiple packages are unstowed together.
  # See https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1106412.
  #
  # When unstowing a package would leave only one symlink for another package in
  # the parent directory, `stow` plans to replace the parent directory with a
  # symlink pointing to the directory containing the remaining package. However,
  # if that package is also being unstowed in the same invocation, `stow`
  # cancels the symlink creation plan but leaves the directory removal
  # planned, which could cause unstow on subsequent packages to fail. For
  # example:
  #
  #     stow --dotfiles -t ~ -D xeo-utils-desktop shell sway
  #
  # When planning to unstow 'xeo-utils-desktop', `stow` finds that removing
  # ~/.local/libexec/xeo-utils-desktop would leave only ~/.local/libexec/shell.
  # It therefore plans to replace the real directory ~/.local/libexec with a
  # symlink to ${DOTFILES_ROOT}/shell/dot-local/libexec (which is called
  # "folding" in stow). When processing 'shell', it reverts the symlink creation
  # plan but leaves the directory removal planned. Finally, when processing
  # 'sway', `stow` encounters a logical inconsistency: it needs to unstow a
  # package from ~/.local/libexec, which is already scheduled for removal,
  # resulting in the error "unstow_contents() called with invalid target:
  # .local/libexec".
  #
  # I personally consider this a bug or design flaw in `stow`. Ideally, it
  # should consider all requested packages together to make a final decision,
  # rather than planning package by package.
  #
  #stow "${stow_cmd_args[@]}" -D "$@"
  local _p
  for _p in "$@"; do
    stow "${stow_cmd_args[@]}" -D "${_p}" || return $?
  done

  postproc_for_unstow
}

# -----------------------------------------------------------------------------
# Restow requested packages.
#
# Globals:
#   added_pkgs
#   added_pkgs_cache
#   missing_pkgs
#   pkgs_need_postproc
#   recommended_pkgs
#
# Arguments:
#   A list of strings representing the packages requested to be restowed.
#
# Returns:
#   0 if restow succeeds; non-zero otherwise.
# -----------------------------------------------------------------------------
do_restow() {
  do_unstow "$@" || return $?
  pkgs_need_postproc=()
  missing_pkgs=()
  recommended_pkgs=()
  added_pkgs=()
  added_pkgs_cache=$'\n'
  do_stow "$@" || return $?
}

# -----------------------------------------------------------------------------
# Dump dotfiles from the current working tree or a Git commit to a snapshot
# directory.
#
# Arguments:
#   $1: A string representing the commit id.
#   $2: A string representing the path of the snapshot directory.
#
# Returns:
#   0 on a success dump; non-zero on errors.
# -----------------------------------------------------------------------------
dump_snapshot() {
  local _commit="$1"
  local _snapdir="$2"

  # Ensure we are in a git repository, thus preventing dumping in the snapshot
  # directory.
  local _gitdir
  if ! _gitdir="$(git rev-parse --git-dir)"; then
    say_err "directory '${PWD}' is not a valid Git repository"
    return 1
  fi

  local _sha
  local _is_worktree=0

  if [[ "${_commit}" == 'WORKTREE' ]]; then
    _sha='WORKTREE'
    _is_worktree=1
  elif ! _sha="$(git --git-dir="${_gitdir}" rev-parse --verify "${_commit}^{commit}" 2>/dev/null)"; then
    say_err "invalid Git commit '${_commit}'"
    return 1
  fi

  local _sha_cache="${_snapdir}/.snapshot-hash"
  if [[ -d "${_snapdir}" ]]; then
    [[ "${_is_worktree}" == 0 \
       &&  -s "${_sha_cache}" \
       && "$(cat "${_sha_cache}")" == "${_sha}" ]] && return 0

    local _first_prompt=1
    local _ans
    while true; do
      if [[ "${_first_prompt}" = 1 ]]; then
        _first_prompt=0
      else
        printf '\033[1A\033[K'
      fi
      read -rp "Snapshot already exists at '${_snapdir}'! Dump anyway? (Y/n): " _ans
      case "${_ans}" in
        n|N)
          say 'cancelled by user'
          return 0
          ;;
        ''|y|Y)
          if  rm -rf "${_snapdir}"; then
            break
          else
            say_err "failed to clear the existing snapshot '${_snapdir}'"
            return 1
          fi
          ;;
        *)
          printf 'Invalid input. Please try again!\n' >&2
          ;;
      esac
    done
  fi

  if ! mkdir -p "${_snapdir}"; then
    say_err "failed to create the snapshot directory '${_snapdir}'"
    return 1
  fi

  if [[ "${_is_worktree}" == 1 ]]; then
    say "dumping dotfiles from current worktree to '${_snapdir}'"
    local _item
    for _item in ./*; do
      if ! cp -a "${_item}" "${_snapdir}/"; then
        say_err "error dumping '${_item}'"
        return 1
      fi
    done
  else
    say "dumping dotfiles from '${_sha:0:7}' to '${_snapdir}'"
    if ! git --git-dir="${_gitdir}" archive "${_sha}" \
        | tar -x -C "${_snapdir}" 2>/dev/null; then
      say_err "error dumping commit '${_sha:0:7}'"
      return 1
    fi
  fi

  # Extract and dump Git submodules.
  local _sm_name _sm_path _sm_sha
  while read -r _sm_name _sm_path; do
    _sm_name="${_sm_name#submodule.}"
    _sm_name="${_sm_name%.path}"
    _sm_sha="$(git ls-tree --full-name "${_sha}" "${_sm_path}" | awk '{print $3}')"
    if [[ -n "${_sm_sha}" && -d ".git/modules/${_sm_name}" ]]; then
      say "dumping submodule '${_sm_name}'"
      if ! git --git-dir=".git/modules/${_sm_name}" archive "${_sm_sha}" \
          | tar -x -C "${_snapdir}/${_sm_path}"; then
        say_err "error dumping submodule '${_sm_name}'"
        return 1
      fi
    fi
  done < <(git config --blob "${_sha}:.gitmodules" --get-regexp 'submodule\..*\.path' 2>/dev/null)

  printf '%s' "${_sha}" > "${_sha_cache}"

  return 0
}

# -----------------------------------------------------------------------------
# A cleanup callback function intended to be invoked in EXIT trap.
#
# Globals:
#   in_select_menu
#   is_setup_started
#   need_popd
#   old_ps3
#
# Arguments:
#   None
# -----------------------------------------------------------------------------
on_exit() {
  local _status=$?
  trap - EXIT

  if [[ -n "${is_setup_started:-}" ]]; then
    if [[ "${in_select_menu}" == 1 && "${old_ps3+1}" == 1 ]]; then
      PS3="${old_ps3}"
      printf '\n'
    fi
    case "${_status}" in
      0)
        say 'setup complete'
        ;;
      130)
        say 'setup manually interrupted (by SIGINT)'
        ;;
      143)
        say 'setup manually killed (by SITERM)'
        ;;
      *)
        say_err 'setup incomplete'
        ;;
    esac
  fi

  if [[ -n "${need_popd:-}" ]]; then
    popd >/dev/null || _status=$?
    say "leaving directory '${DOTFILES_ROOT}'"
  fi

  exit "${_status}"
}

# -----------------------------------------------------------------------------
# Print help information.
# -----------------------------------------------------------------------------
usage() {
  cat <<EOF
A helper script for managing xeo-dotfiles.

Usage: "${PROGNAME}" <COMMAND> [OPTIONS] <PKG>...

Commands:
  deploy  Deploy (stow/unstow/restow) dotfiles selectively
  dump    Dump dotfiles from the current working tree or a specified commit as a
          snapshot to a directory

Deploy options:
  -D           Undeploy (unstow) dotfiles
  -R           Redeploy (restow) dotfiles
  -a           Operate on all packages unless a <PKG> is present
  -f           Use 'refolding' for unstow, removing empty target directories or
               replacing a target directory containing only symlinks to a single
               other package with a symlink to the surviving package's
               installation image; even without this option, the script may
               prompt for the removal of empty directories for some packages
  -n           Do not actually make any filesystem changes (dry-run)
  -r           Restow (unstow and then stow) dotfiles for specified packages
  -t <TARGET>  Specify target directory to <TARGET>; if not specified, use user
               home (~) as default
  -v <N>       Increase verbosity (levels are from 0 to 5, default is 1)
  -x <PKG>     Exclude a package. Use it multiple times to exclude multiple
               packages

Dump options:
  -c <COMMIT>  Use a Git <COMMIT> object as the snapshot, <COMMIT> can be a
               commit SHA1 hash, a branch name or a tag; if not present, dump
               the current working tree
  -d <DIR>     Use <DIR> as the snapshot directory, <DIR> must be a path inside
               the user home for security concerns; if not present, default to
               \$XDG_STATE_HOME/xeo-dotfiles or ~/.local/state/xeo-dotfiles if
               XDG_STATE_HOME is not set

Global optoins:
  -h           Print this help and exit
EOF
}

# -----------------------------------------------------------------------------
# Main entry.
#
# Globals:
#   bin_root
#   config_root
#   libexec_root
#   need_popd
#   is_setup_started
#   stow_cmd_args
#   tgt_root
#
# Arguments:
#   The command-line arguments passed to this script.
# -----------------------------------------------------------------------------
main() {
  [[ $# -gt 0 ]] || die_with_hint 'missing operand'
  command -v stow >/dev/null 2>&1 || die "cannot find command 'stow'"

  # Ensure we are in dotfiles root.
  if [[ "$(pwd -P)" != "${DOTFILES_ROOT}" ]]; then
    say "entering directory '${DOTFILES_ROOT}'"
    pushd "${DOTFILES_ROOT}" >/dev/null || exit $?
    need_popd=1
  fi

  local _opt

  case "$1" in
    dump)
      shift
      local _commit='WORKTREE'
      local _snapdir="${DOTFILES_SNAPSHOT_DIR}"
      while getopts ':c:d:' _opt; do
        case "${_opt}" in
          c)
            _commit="${OPTARG}"
            ;;
          d)
            _snapdir="${OPTARG/#~/${HOME}}"
            if [[ "$(realpath -m -- "${_snapdir}")" != "${HOME}"/* ]]; then
              die_with_hint 'snapshot directory outside user home'
            fi
            ;;
          :)
            die_with_hint "option '${OPTARG}' requires an argument"
            ;;
          \?)
            if [[ "${OPTARG}" == '-' ]]; then  # long options
              die_with_hint "invalid option -- '${!OPTIND#-}'"
            fi
            die_with_hint "invalid option -- '${OPTARG}'"
            ;;
        esac
      done
      if dump_snapshot "${_commit}" "${_snapdir}"; then
        say 'snapshot dump complete'
        printf "\e[1;33m!!!\e[0m To deploy the dumped dotfiles, enter \e[4m%s\e[0m and run the \e[1;32msetup\e[0m script \e[1;33m!!!\e[0m\n" "${_snapdir}"
        exit 0
      else
        say_err 'snapshot dump failed to complete'
        exit 1
      fi
      ;;
    deploy)
      shift
      ;;
    *)
      die_with_hint "invalid command -- '$1'"
  esac
  OPTIND=1

  local _stow_opt_sdr='S'
  local _stow_all_pkgs=0
  local _excluded_pkgs=()

  while getopts ':DRafhnt:v:x:' _opt; do
    case "${_opt}" in
      D)
        if [[ "${_stow_opt_sdr}" == 'R' ]]; then
          die_with_hint "options '-d' and '-r' are mutually exclusive"
        fi
        _stow_opt_sdr='D'
        ;;
      R)
        if [[ "${_stow_opt_sdr}" == 'D' ]]; then
          die_with_hint "options '-r' and '-d' are mutually exclusive"
        fi
        _stow_opt_sdr='R'
        ;;
      a)
        _stow_all_pkgs=1
        ;;
      f)
        readonly _stow_opt_refolding=1
        ;;
      n)
        stow_cmd_args+=('-n')
        ;;
      t)
        tgt_root="${OPTARG/#~/${HOME}}"  # expand ~ if present
        ;;
      v)
        [[ "${OPTARG}" -ge 0 && "${OPTARG}" -le 5 ]] \
          || die_with_hint "invalid -${_opt} argument '${OPTARG}'"
        stow_cmd_args+=('-v' "${OPTARG}")
        ;;
      x)
        _excluded_pkgs+=("${OPTARG}")
        ;;
      h)
        usage
        exit 0
        ;;
      :)
        die_with_hint "option '${OPTARG}' requires an argument"
        ;;
      \?)
        if [[ "${OPTARG}" == '-' ]]; then  # long options
          die_with_hint "invalid option -- '${!OPTIND#-}'"
        fi
        die_with_hint "invalid option -- '${OPTARG}'"
        ;;
    esac
  done
  shift $((OPTIND - 1))  # shift all optional args, leaving only positional args
  unset _opt

  # Target root must exist.
  [[ -d "${tgt_root}" ]] || die "target directory '${tgt_root}' does not exist"

  local -a _pkgs
  local _p
  # Positional argument shadows the -a option.
  if [[ "${_stow_all_pkgs}" == 1 && $# -eq 0 ]]; then
    # No positional args found, but the -a option is present, find all packages
    # in the dotfiles root.
    for _p in */; do
      _pkgs+=("${_p%/}")
    done
  else
    # INFO: No need to deduplicate packages, as `stow` will do it.
    _pkgs=("$@")
  fi

  if [[ ${#_pkgs[@]} -eq 0 ]]; then
    say "no package requested"
    exit 0
  fi

  if [[ ${#_excluded_pkgs[@]} -gt 0 ]]; then
    local _filtered_pkgs=()
    local _skip
    for _p in "${_pkgs[@]}"; do
      _skip=0
      local _e
      for _e in "${_excluded_pkgs[@]}"; do
        if [[ "${_p}" == "${_e}" ]]; then
          _skip=1
          break
        fi
      done
      [[ "${_skip}" == 1 ]] || _filtered_pkgs+=("${_p}")
    done
    if [[ ${#_filtered_pkgs[@]} -eq 0 ]]; then
      say "no package requested"
      exit 0
    fi
    set -- "${_filtered_pkgs[@]}"
  else
    set -- "${_pkgs[@]}"
  fi

  stow_cmd_args+=('-t' "${tgt_root}")

  config_root="${tgt_root}/.config"
  bin_root="${tgt_root}/.local/bin"
  libexec_root="${tgt_root}/.local/libexec"

  say "starting setup"
  is_setup_started=1

  case "${_stow_opt_sdr}" in
    S)
      do_stow "$@"
      ;;
    D)
      [[ -n "${_stow_opt_refolding:-}" ]] || stow_cmd_args+=('--no-folding')
      do_unstow "$@"
      ;;
    R)
      do_restow "$@"
      ;;
  esac
}

# Register the cleanup callback function.
# For Unix shell convention, the exit code for a process killed by signal N
# should be 128 + N.
trap 'on_exit' EXIT
trap 'exit 130' INT   # 128 + SIGINT (2)
trap 'exit 143' TERM  # 128 + SIGTERM (15)

main "$@"
