#
# A xeo utility script that switches between preset dark and light color themes
# for some CLI and TUI applications .
#
# This script exists because:
# - Most CLI or TUI applications supporting color theme (e.g., `delta`) are not
#   able to dynamically switch between themes to fit the terminal background.
# - Although some applications can query the terminal background through OSC 11
#   escape sequences, but it depends on whether a terminal emulator supports it
#   and what escape sequences a terminal emulator accepts.
#
# Currently supported applications include: delta, foot, ghostty, kitty.
#
# NOTE: Some applications must use a specific configuration layout for this
# script to work with them.

[[ "${BASH_SOURCE[0]}" == "$0" ]] || exit

PROGNAME="$(basename -- "$0")"
readonly PROGNAME

readonly DELTA_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/delta"
readonly FOOT_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/foot"
readonly GHOSTTY_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/ghostty"
readonly KITTY_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/kitty"

say() {
  printf '\e[1m%s:\e[0m %b\n' "${PROGNAME}" "$1"
}

say_err() {
  printf '\e[1m%s:\e[0m \e[31merror:\e[0m %b\n' "${PROGNAME}" "$1" >&2
}

app_say_err() {
  printf '\e[1m%s:\e[0m \e[31m%s:\e[0m %b\n' "${PROGNAME}" "$1" "$2" >&2
}

check_cmd() {
  command -v "$1" >/dev/null 2>&1
}

switch_delta_theme() {
  check_cmd 'delta' && [[ -d "${DELTA_CONFIG_DIR}/themes" ]] || return 0

  local _envvar="DELTA_THEME_$1"
  local _curr_theme_file="${DELTA_CONFIG_DIR}/current-theme.gitconfig"

  if [ -n "${!_envvar:-}" ]; then
    if [ -f "${DELTA_CONFIG_DIR}/themes/${!_envvar}.gitconfig" ]; then
      [ "$(readlink "${_curr_theme_file}")" = "themes/${!_envvar}.gitconfig" ] \
        || ln -sf "themes/${!_envvar}.gitconfig" "${_curr_theme_file}"
    else
      app_say_err 'delta' "invalid theme \e[1m${!_envvar}\e[0m"
    fi
  else
    app_say_err 'delta' "${_envvar} is not set"
  fi
}

switch_foot_theme() {
  check_cmd foot && [[ -d "${FOOT_CONFIG_DIR}/themes" ]] || return 0

  local _envvar="FOOT_THEME_$1"
  local _curr_theme_file
  _curr_theme_file="${FOOT_CONFIG_DIR}/current-theme-$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]').ini" \
    || return

  if [ -n "${!_envvar:-}" ]; then
    if [ -f "${FOOT_CONFIG_DIR}/themes/${!_envvar}.ini" ]; then
      [ "$(readlink "${_curr_theme_file}")" != "themes/${!_envvar}.ini" ] \
        && ln -sf "themes/${!_envvar}.ini" "${_curr_theme_file}" \
        && pkill -f -SIGUSR2 'foot --server'
    else
      app_say_err 'foot' "invalid theme \e[1m${!_envvar}\e[0m"
    fi
  else
    app_say_err 'foot' "${_envvar} is not set"
  fi
}

switch_ghostty_theme() {
  check_cmd 'ghostty' && [[ -d "${GHOSTTY_CONFIG_DIR}/themes" ]] || return 0

  local _envvar="GHOSTTY_THEME_$1"
  local _auto_theme_file

  case "${OSTYPE}" in
    darwin*)
      _auto_theme_file="${HOME}/Library/Application Support/com.mitchellh.ghostty/auto/theme.ghostty"
      ;;
    linux*)
      _auto_theme_file='auto/theme.ghostty'
      ;;
    *) # unsupported platform
      return 0
      ;;
  esac

  if [ -n "${!_envvar:-}" ]; then
    if ghostty +list-themes --plain | grep -Eq "^${!_envvar} \((resources|user)\)$"; then
      printf 'theme = %s\n' "${!_envvar}" >"${_auto_theme_file}" \
        && killall -SIGUSR2 ghostty
    else
      app_say_err 'ghostty' "invalid theme \e[1m${!_envvar}\e[0m"
    fi
  else
    app_say_err 'ghostty' "${_envvar} is not set"
  fi
}

switch_kitty_theme() {
  check_cmd 'kitty' && [[ -d "${KITTY_CONFIG_DIR}/themes" ]] || return 0

  local _envvar="KITTY_THEME_$1"

  if [ -n "${!_envvar:-}" ]; then
    kitty +kitten themes --config-file-name='theme-loader.conf' "${!_envvar}" \
      || app_say_err 'kitty' "invalid theme \e[1m${!_envvar}\e[0m"
  else
    app_say_err 'kitty' "${_envvar} is not set"
  fi
}

switch_theme_mode() {
  switch_delta_theme "$1"
  switch_foot_theme "$1"
  switch_ghostty_theme "$1"
  switch_kitty_theme "$1"
}

on_exit() {
  local _state=$?
  if [[ -n "${old_tty_state:-}" ]]; then
    stty "${old_tty_state}"
    printf '\n'
  fi
  exit ${_state}
}

# HACK: A workaround for invoking this script with a bash key binding.
#
# In an interactive shell session, Bash uses the GNU Readline library for line
# editing. When you are typing in a terminal, Bash works as follows:
#
# * Bash (Readline) switches the terminal to raw mode where the terminal can see
#   every single key you press in real time.
# * When you finish typing a command and press Enter, Bash temporarily sets the
#   terminal back to the standard cooked (sane) mode, allowing the command to
#   read user input from the terminal.
# * After the command completes, Bash switches the terminal back to raw mode,
#   starting a new command-line prompt.
#
# However, when a command to execute is triggered by a keyboard shortcut defined
# with `bind -x`, Bash directly pauses the line editor and runs the command
# without resetting the terminal to sane mode, so the running command is not
# able to read user input from the terminal.
#
# To work around this limitation, we manually set the terminal to sane mode,
# thus allowing the `read` command to get user input, and then restore the
# original terminal state right after the read finishes.
#
# What's interesting is that Zsh doesn't seem to suffer from the same issue. Is
# this true? When Zsh is going to execute a command triggered by a key binding
# defined with `bindkey -s`, its line editor (ZLE) inserts each character of the
# bound command into the command line as if you were typing in the command by
# hand, and Zsh will set the terminal to sane mode right before executing the
# command. However, when a key binding triggers a ZLE widget, Zsh won't reset
# the terminal mode before executing the widget, keeping the line editor active
# while the widget is running, which will cause exactly the same issue as in
# Bash.
main() {
  old_tty_state="$(stty -g)"
  stty sane

  local _choice
  printf 'Choose \e[1md\e[0mark or \e[1ml\e[0might mode? (d/l): '
  read -r _choice
  stty "${old_tty_state}" && unset old_tty_state

  case "${_choice:-}" in
    d)
      switch_theme_mode 'DARK'
      ;;
    l)
      switch_theme_mode 'LIGHT'
      ;;
    '')
      exit 0
      ;;
    *)
      say_err "invalid choice -- '${_choice}'"
      exit 1
      ;;
  esac
}

trap 'on_exit' EXIT
trap 'exit 130' INT

main "$@"
